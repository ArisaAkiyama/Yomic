<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
    <!-- Navigation Labels -->
    <sys:String x:Key="String.Library">Perpustakaan</sys:String>
    <sys:String x:Key="String.Updates">Pembaruan</sys:String>
    <sys:String x:Key="String.Upcoming">Kalender</sys:String>
    <sys:String x:Key="String.History">Riwayat</sys:String>
    <sys:String x:Key="String.Downloads">Unduhan</sys:String>
    <sys:String x:Key="String.BrowseSources">Jelajahi Sumber</sys:String>
    <sys:String x:Key="String.Extensions">Ekstensi</sys:String>
    <sys:String x:Key="String.SendFeedback">Kirim Masukan</sys:String>
    <sys:String x:Key="String.Settings">Pengaturan</sys:String>

    <!-- Settings Titles & Descriptions -->
    <sys:String x:Key="String.General">Umum</sys:String>
    <sys:String x:Key="String.DarkMode">Mode Gelap</sys:String>
    <sys:String x:Key="String.DarkModeDesc">Gunakan preferensi tema gelap sistem</sys:String>
    <sys:String x:Key="String.OfflineMode">Mode Offline</sys:String>
    <sys:String x:Key="String.OfflineModeDesc">Paksa aplikasi untuk hanya menggunakan konten terunduh</sys:String>
    <sys:String x:Key="String.ShowNsfwSources">Tampilkan Sumber NSFW</sys:String>
    <sys:String x:Key="String.ShowNsfwSourcesDesc">Tampilkan ekstensi dengan konten 18+ di Jelajahi</sys:String>
    <sys:String x:Key="String.AutoUpdate">Pembaruan Otomatis</sys:String>
    <sys:String x:Key="String.AutoUpdateDesc">Periksa pembaruan secara otomatis saat aplikasi dimulai</sys:String>
    
    <sys:String x:Key="String.AppLanguage">Bahasa</sys:String>
    <sys:String x:Key="String.AppLanguageDesc">Pilih bahasa antarmuka pengguna aplikasi (memerlukan restart)</sys:String>

    <!-- Dialogs & Buttons -->
    <sys:String x:Key="String.Confirm">Konfirmasi</sys:String>
    <sys:String x:Key="String.Cancel">Batal</sys:String>
    <sys:String x:Key="String.RestartRequired">Restart Diperlukan</sys:String>
    <sys:String x:Key="String.RestartMessage">Aplikasi perlu dimulai ulang untuk menerapkan bahasa baru. Apakah Anda ingin restart sekarang?</sys:String>

    <!-- Network Section -->
    <sys:String x:Key="String.Network">Jaringan</sys:String>
    <sys:String x:Key="String.DnsOverHttps">DNS melalui HTTPS</sys:String>
    <sys:String x:Key="String.DnsOverHttpsDesc">Bypass pemblokiran DNS dengan penyelesaian melalui HTTPS</sys:String>
    <sys:String x:Key="String.Disabled">Dinonaktifkan</sys:String>

    <!-- Library Section -->
    <sys:String x:Key="String.LibraryHeader">Perpustakaan</sys:String>
    <sys:String x:Key="String.AutoSyncLibrary">Sinkronisasi Otomatis</sys:String>
    <sys:String x:Key="String.AutoSyncLibraryDesc">Periksa bab baru secara otomatis saat startup aplikasi</sys:String>
    <sys:String x:Key="String.SmartUpdate">Pembaruan Cerdas</sys:String>
    <sys:String x:Key="String.Recommended">Direkomendasikan</sys:String>
    <sys:String x:Key="String.SmartUpdateDesc">Prioritaskan memperbarui manga aktif dan lewati komik selesai/hiatus untuk menghemat kuota</sys:String>
    <sys:String x:Key="String.BackgroundAutoUpdate">Pembaruan Latar Belakang</sys:String>
    <sys:String x:Key="String.BackgroundAutoUpdateDesc">Perbarui perpustakaan di latar belakang tanpa membuka aplikasi (Menggunakan Penjadwal Tugas Windows)</sys:String>
    <sys:String x:Key="String.UpdateIntervalOff">Nonaktif (Hanya Manual)</sys:String>
    <sys:String x:Key="String.UpdateInterval6h">Setiap 6 Jam</sys:String>
    <sys:String x:Key="String.UpdateInterval12h">Setiap 12 Jam</sys:String>
    <sys:String x:Key="String.UpdateInterval24h">Setiap 24 Jam</sys:String>
    <sys:String x:Key="String.RefreshLibraryCovers">Segarkan Sampul</sys:String>
    <sys:String x:Key="String.RefreshLibraryCoversDesc">Unduh ulang gambar sampul untuk semua manga di perpustakaan Anda</sys:String>
    <sys:String x:Key="String.Refresh">Segarkan</sys:String>

    <!-- Security Section -->
    <sys:String x:Key="String.Security">Keamanan</sys:String>
    <sys:String x:Key="String.BlurExplicitCovers">Samarkan Sampul Eksplisit</sys:String>
    <sys:String x:Key="String.BlurExplicitCoversDesc">Samarkan gambar sampul yang mengandung konten eksplisit di Perpustakaan</sys:String>

    <!-- Reader Section -->
    <sys:String x:Key="String.Reader">Pembaca</sys:String>
    <sys:String x:Key="String.PreloadNextChapter">Muat Awal Bab Berikutnya</sys:String>
    <sys:String x:Key="String.PreloadNextChapterDesc">Unduh halaman bab berikutnya di latar belakang saat mendekati akhir bab saat ini</sys:String>
    <sys:String x:Key="String.AutoDownloadNextChapter">Unduh Otomatis Bab Berikutnya</sys:String>
    <sys:String x:Key="String.AutoDownloadNextChapterDesc">Secara otomatis menambahkan bab berikutnya ke antrean Unduhan saat membaca</sys:String>
    <sys:String x:Key="String.SkipFilteredChapters">Lewati Bab yang Difilter</sys:String>
    <sys:String x:Key="String.SkipFilteredChaptersDesc">Lewati bab yang difilter di halaman detail manga secara otomatis saat membaca</sys:String>
    <sys:String x:Key="String.ReaderPerformanceMode">Mode Performa Pembaca</sys:String>
    <sys:String x:Key="String.ReaderPerformanceModeDesc">Optimalkan performa pembaca dengan membatasi unduhan bersamaan (2) dan dekode gambar (1) untuk kenyamanan membaca</sys:String>
    <sys:String x:Key="String.MaxReaderCacheSize">Ukuran Cache Maksimum Pembaca</sys:String>
    <sys:String x:Key="String.MaxReaderCacheSizeDesc">Hapus cache pembaca tertua secara otomatis ketika batas ukuran terlampaui</sys:String>

    <!-- Data & Storage Section -->
    <sys:String x:Key="String.DataStorage">Data &amp; Penyimpanan</sys:String>
    <sys:String x:Key="String.CreateBackup">Buat Cadangan</sys:String>
    <sys:String x:Key="String.CreateBackupDesc">Buat salinan cadangan basis data lokal dan pengaturan Anda</sys:String>
    <sys:String x:Key="String.Backup">Cadangkan</sys:String>
    <sys:String x:Key="String.RestoreBackup">Pulihkan Cadangan</sys:String>
    <sys:String x:Key="String.RestoreBackupDesc">Pulihkan data dari file cadangan yang dibuat sebelumnya</sys:String>
    <sys:String x:Key="String.Restore">Pulihkan</sys:String>
    <sys:String x:Key="String.ClearCacheCookies">Hapus Cache &amp; Cookie</sys:String>
    <sys:String x:Key="String.ClearCacheCookiesDesc">Kosongkan memori dan setel ulang koneksi jaringan</sys:String>
    <sys:String x:Key="String.ClearCache">Hapus Cache</sys:String>

    <!-- Advanced Section -->
    <sys:String x:Key="String.Advanced">Tingkat Lanjut</sys:String>
