    <!-- Dialog Confirmation & Warnings -->
    <sys:String x:Key="String.Dialog.RestoreTitle">Pulihkan Cadangan</sys:String>
    <sys:String x:Key="String.Dialog.RestoreMsg">Memulihkan cadangan akan menggantikan semua basis data, perpustakaan, dan pengaturan Anda saat ini. Pastikan Anda memiliki cadangan terbaru jika diperlukan. Apakah Anda ingin melanjutkan?</sys:String>
    <sys:String x:Key="String.Dialog.RestorePickerTitle">Pulihkan Cadangan Yomic</sys:String>
    <sys:String x:Key="String.Dialog.ClearDataTitle">Hapus Semua Data</sys:String>
    <sys:String x:Key="String.Dialog.ClearDataMsg">Apakah Anda benar-benar yakin ingin mengatur ulang semua data? Tindakan ini tidak dapat dibatalkan dan akan menghapus seluruh perpustakaan lokal dan pengaturan Anda.</sys:String>
    <sys:String x:Key="String.Dialog.ClearHistoryTitle">Hapus Riwayat Baca &amp; Cache</sys:String>
    <sys:String x:Key="String.Dialog.ClearHistoryMsg">Apakah Anda yakin ingin menghapus riwayat membaca dan cache gambar Anda? Semua bab akan ditandai sebagai belum dibaca dan memori akan dibebaskan.</sys:String>
    <sys:String x:Key="String.Dialog.DeleteDiskTitle">Hapus dari Disk</sys:String>
    <sys:String x:Key="String.Dialog.DeleteDiskMsg">Ini akan menghapus "{0}" dari perpustakaan Anda dan menghapus bab yang diunduh secara permanen dari disk. Tindakan ini tidak dapat dibatalkan.</sys:String>
    <sys:String x:Key="String.Dialog.DeleteDownloadsTitle">Hapus Semua Unduhan</sys:String>
    <sys:String x:Key="String.Dialog.DeleteDownloadsMsg">Ini akan menghapus semua bab terunduh dari "{0}" secara permanen dari disk. Manga akan tetap berada di perpustakaan Anda. Tindakan ini tidak dapat dibatalkan.</sys:String>
    <sys:String x:Key="String.Dialog.DeleteCategoryTitle">Hapus Kategori</sys:String>
    <sys:String x:Key="String.Dialog.DeleteCategoryMsg">Apakah Anda yakin ingin menghapus kategori "{0}"? Manga dalam kategori ini tidak akan dihapus.</sys:String>

    <!-- Download All Dialog -->
    <sys:String x:Key="String.Dialog.DownloadChapters">Unduh Bab</sys:String>
    <sys:String x:Key="String.Dialog.Total">Total</sys:String>
    <sys:String x:Key="String.Dialog.ToDownload">Akan Diunduh</sys:String>
    <sys:String x:Key="String.Dialog.Unread">Belum Dibaca</sys:String>
    <sys:String x:Key="String.Dialog.DownloadAllOpt">Unduh semua bab</sys:String>
    <sys:String x:Key="String.Dialog.DownloadUnreadOpt">Unduh bab belum dibaca saja</sys:String>
    <sys:String x:Key="String.Dialog.SkipWarning">Bab yang sudah diunduh akan dilewati. Bab terpilih akan dimasukkan ke antrean unduhan.</sys:String>
    <sys:String x:Key="String.Dialog.MassDownloadWarning">Peringatan Unduh Massal:&#x0a;Mengunduh lebih dari 20 bab sekaligus dapat memicu perlindungan Anti-Bot (seperti Cloudflare) pada server sumber. Jika IP Anda diblokir, Anda tidak akan dapat membaca dari sumber ini untuk sementara waktu.</sys:String>
    <sys:String x:Key="String.Dialog.StartDownload">Mulai Unduh</sys:String>

    <!-- Feedback Dialog -->
    <sys:String x:Key="String.Feedback.Title">Kirim Masukan</sys:String>
    <sys:String x:Key="String.Feedback.Watermark">Beri tahu kami pengalaman Anda menggunakan aplikasi ini...</sys:String>
    <sys:String x:Key="String.Feedback.AttachScreenshot">Lampirkan Tangkapan Layar</sys:String>
    <sys:String x:Key="String.Feedback.AttachScreenshotWithCount">Lampirkan Tangkapan Layar ({0}/{1})</sys:String>
    <sys:String x:Key="String.Feedback.RemoveTooltip">Hapus tangkapan layar</sys:String>
    <sys:String x:Key="String.Feedback.PrivacyText">Masukan Anda bersifat anonim dan membantu kami meningkatkan Yomic. Hanya pesan Anda dan lampiran tangkapan layar yang akan dikirim. Pesan pribadi dan perpustakaan Anda tetap aman di perangkat Anda.</sys:String>
    <sys:String x:Key="String.Feedback.Submit">Kirim</sys:String>
    <sys:String x:Key="String.Feedback.Category.BugReport">Laporan Bug</sys:String>
    <sys:String x:Key="String.Feedback.Category.FeatureRequest">Permintaan Fitur</sys:String>
    <sys:String x:Key="String.Feedback.Category.Question">Pertanyaan</sys:String>
    <sys:String x:Key="String.Feedback.PickerNotAvailable">Pemilih tangkapan layar tidak tersedia.</sys:String>
