    <sys:String x:Key="String.DatabaseStatisticsDesc">Ikhtisar basis data manga lokal Anda</sys:String>
    <sys:String x:Key="String.OptimizeDb">Optimalkan DB</sys:String>
    <sys:String x:Key="String.Manga">Manga</sys:String>
    <sys:String x:Key="String.Chapters">Bab</sys:String>
    <sys:String x:Key="String.HistoryLabel">Riwayat</sys:String>
    <sys:String x:Key="String.DbSize">Ukuran DB</sys:String>
    <sys:String x:Key="String.ExportAppLogs">Ekspor Log Aplikasi</sys:String>
    <sys:String x:Key="String.ExportAppLogsDesc">Simpan file log aplikasi untuk pelaporan bug atau pemecahan masalah</sys:String>
    <sys:String x:Key="String.ExportLogs">Ekspor Log</sys:String>

    <!-- Danger Zone Section -->
    <sys:String x:Key="String.DangerZone">Zona Bahaya</sys:String>
    <sys:String x:Key="String.ClearHistoryCache">Hapus Riwayat Baca &amp; Cache</sys:String>
    <sys:String x:Key="String.ClearHistoryCacheDesc">Setel ulang semua bab ke status belum dibaca dan bebaskan memori</sys:String>
    <sys:String x:Key="String.ClearAll">Hapus Semua</sys:String>
    <sys:String x:Key="String.ClearAllData">Hapus Semua Data</sys:String>
    <sys:String x:Key="String.ClearAllDataDesc">Tindakan tidak dapat dibatalkan untuk menghapus basis data lokal</sys:String>
    <sys:String x:Key="String.ResetData">Setel Ulang Data</sys:String>

    <!-- About Section -->
    <sys:String x:Key="String.About">Tentang</sys:String>
    <sys:String x:Key="String.AboutDesc1">Yomic adalah pembaca komik web gratis dan bersumber terbuka, dirancang untuk pengalaman membaca desktop yang premium.</sys:String>
    <sys:String x:Key="String.AboutDesc2">Aplikasi ini mengumpulkan konten dari sumber populer, memungkinkan Anda membaca cerita favorit tanpa gangguan iklan.</sys:String>
    <sys:String x:Key="String.VisitWebsite">Kunjungi Situs</sys:String>
    
