    <sys:String x:Key="String.HistoryLabel">History</sys:String>
    <sys:String x:Key="String.DbSize">DB Size</sys:String>
    <sys:String x:Key="String.ExportAppLogs">Export App Logs</sys:String>
    <sys:String x:Key="String.ExportAppLogsDesc">Save the application log file for bug reporting or troubleshooting</sys:String>
    <sys:String x:Key="String.ExportLogs">Export Logs</sys:String>

    <!-- Danger Zone Section -->
    <sys:String x:Key="String.DangerZone">Danger Zone</sys:String>
    <sys:String x:Key="String.ClearHistoryCache">Clear Read History &amp; Cache</sys:String>
    <sys:String x:Key="String.ClearHistoryCacheDesc">Reset all chapters to unread status and free up memory</sys:String>
    <sys:String x:Key="String.ClearAll">Clear All</sys:String>
    <sys:String x:Key="String.ClearAllData">Clear All Data</sys:String>
    <sys:String x:Key="String.ClearAllDataDesc">Irreversible action to clear local database</sys:String>
    <sys:String x:Key="String.ResetData">Reset Data</sys:String>

    <!-- About Section -->
    <sys:String x:Key="String.About">About</sys:String>
    <sys:String x:Key="String.AboutDesc1">Yomic is a free and open source web comic reader, designed for a premium desktop reading experience.</sys:String>
    <sys:String x:Key="String.AboutDesc2">It aggregates content from popular sources, allowing you to read your favorite stories distraction-free.</sys:String>
    <sys:String x:Key="String.VisitWebsite">Visit Website</sys:String>
    
