    <sys:String x:Key="String.ClearCacheCookiesDesc">Free up memory and reset network connections</sys:String>
    <sys:String x:Key="String.ClearCache">Clear Cache</sys:String>

    <!-- Advanced Section -->
    <sys:String x:Key="String.Advanced">Advanced</sys:String>
