<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
    <!-- Navigation Labels -->
    <sys:String x:Key="String.Library">Library</sys:String>
    <sys:String x:Key="String.Updates">Updates</sys:String>
    <sys:String x:Key="String.Upcoming">Upcoming</sys:String>
    <sys:String x:Key="String.History">History</sys:String>
