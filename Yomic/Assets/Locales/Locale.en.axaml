    <!-- Settings Titles & Descriptions -->
    <sys:String x:Key="String.General">General</sys:String>
    <sys:String x:Key="String.DarkMode">Dark Mode</sys:String>
    <sys:String x:Key="String.DarkModeDesc">Use system dark theme preferences</sys:String>
    <sys:String x:Key="String.OfflineMode">Offline Mode</sys:String>
    <sys:String x:Key="String.OfflineModeDesc">Force application to use downloaded content only</sys:String>
    <sys:String x:Key="String.ShowNsfwSources">Show NSFW Sources</sys:String>
    <sys:String x:Key="String.ShowNsfwSourcesDesc">Display extensions with 18+ content in Browse</sys:String>
    <sys:String x:Key="String.AutoUpdate">Auto-Update</sys:String>
    <sys:String x:Key="String.AutoUpdateDesc">Check for updates automatically on startup</sys:String>
    
    <sys:String x:Key="String.AppLanguage">Language</sys:String>
    <sys:String x:Key="String.AppLanguageDesc">Select application UI language (requires restart)</sys:String>

    <!-- Dialogs & Buttons -->
    <sys:String x:Key="String.Confirm">Confirm</sys:String>
    <sys:String x:Key="String.Cancel">Cancel</sys:String>
    <sys:String x:Key="String.RestartRequired">Restart Required</sys:String>
    <sys:String x:Key="String.RestartMessage">The application needs to restart to apply the new language. Do you want to restart now?</sys:String>

    <!-- Network Section -->
    <sys:String x:Key="String.Network">Network</sys:String>
    <sys:String x:Key="String.DnsOverHttps">DNS over HTTPS</sys:String>
    <sys:String x:Key="String.DnsOverHttpsDesc">Bypass DNS blocking by resolving over HTTPS</sys:String>
    <sys:String x:Key="String.Disabled">Disabled</sys:String>

    <!-- Library Section -->
    <sys:String x:Key="String.LibraryHeader">Library</sys:String>
    <sys:String x:Key="String.AutoSyncLibrary">Auto-Sync Library</sys:String>
    <sys:String x:Key="String.AutoSyncLibraryDesc">Automatically check for new chapters on startup</sys:String>
    <sys:String x:Key="String.SmartUpdate">Smart Update</sys:String>
    <sys:String x:Key="String.Recommended">Recommended</sys:String>
    <sys:String x:Key="String.SmartUpdateDesc">Prioritize updating active manga and skip completed/hiatus titles to save bandwidth</sys:String>
    <sys:String x:Key="String.BackgroundAutoUpdate">Background Auto-Update</sys:String>
    <sys:String x:Key="String.BackgroundAutoUpdateDesc">Update library in the background without opening the app (Uses Windows Task Scheduler)</sys:String>
    <sys:String x:Key="String.UpdateIntervalOff">Off (Manual Only)</sys:String>
    <sys:String x:Key="String.UpdateInterval6h">Every 6 Hours</sys:String>
    <sys:String x:Key="String.UpdateInterval12h">Every 12 Hours</sys:String>
    <sys:String x:Key="String.UpdateInterval24h">Every 24 Hours</sys:String>
    <sys:String x:Key="String.RefreshLibraryCovers">Refresh Library Covers</sys:String>
    <sys:String x:Key="String.RefreshLibraryCoversDesc">Re-download cover thumbnails for all manga in your library</sys:String>
    <sys:String x:Key="String.Refresh">Refresh</sys:String>

    <!-- Security Section -->
    <sys:String x:Key="String.Security">Security</sys:String>
    <sys:String x:Key="String.BlurExplicitCovers">Blur Explicit Covers</sys:String>
    <sys:String x:Key="String.BlurExplicitCoversDesc">Blur cover images containing explicit content in Library</sys:String>

    <!-- Reader Section -->
    <sys:String x:Key="String.Reader">Reader</sys:String>
    <sys:String x:Key="String.PreloadNextChapter">Preload Next Chapter</sys:String>
    <sys:String x:Key="String.PreloadNextChapterDesc">Download pages of the next chapter in the background when nearing the end of current chapter</sys:String>
    <sys:String x:Key="String.AutoDownloadNextChapter">Auto Download Next Chapter</sys:String>
    <sys:String x:Key="String.AutoDownloadNextChapterDesc">Automatically add the next chapter to the Downloads queue while reading</sys:String>
    <sys:String x:Key="String.SkipFilteredChapters">Skip Filtered Chapters</sys:String>
    <sys:String x:Key="String.SkipFilteredChaptersDesc">Automatically skip chapters that are filtered out in the manga details page while reading</sys:String>
    <sys:String x:Key="String.ReaderPerformanceMode">Reader Performance Mode</sys:String>
    <sys:String x:Key="String.ReaderPerformanceModeDesc">Optimize reader performance by limiting concurrent downloads (2) and image decodes (1) for smoother scrolling</sys:String>
    <sys:String x:Key="String.MaxReaderCacheSize">Max Reader Cache Size</sys:String>
    <sys:String x:Key="String.MaxReaderCacheSizeDesc">Automatically clear oldest reader cache files when the size limit is exceeded</sys:String>

    <!-- Data & Storage Section -->
    <sys:String x:Key="String.DataStorage">Data &amp; Storage</sys:String>
    <sys:String x:Key="String.CreateBackup">Create Backup</sys:String>
    <sys:String x:Key="String.CreateBackupDesc">Create a backup of your local database and settings</sys:String>
    <sys:String x:Key="String.Backup">Backup</sys:String>
    <sys:String x:Key="String.RestoreBackup">Restore Backup</sys:String>
    <sys:String x:Key="String.RestoreBackupDesc">Restore data from a previously created backup file</sys:String>
    <sys:String x:Key="String.Restore">Restore</sys:String>
