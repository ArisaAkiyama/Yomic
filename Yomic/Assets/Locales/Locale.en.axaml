    <sys:String x:Key="String.Dialog.DownloadUnreadOpt">Download unread chapters only</sys:String>
    <sys:String x:Key="String.Dialog.SkipWarning">Downloaded chapters will be skipped. Selected chapters will be added to the Downloads queue.</sys:String>
    <sys:String x:Key="String.Dialog.MassDownloadWarning">Mass Download Warning:&#x0a;Downloading more than 20 chapters at once may trigger Anti-Bot protection (like Cloudflare) on the source server. If your IP is blocked, you will be unable to read from this source temporarily.</sys:String>
    <sys:String x:Key="String.Dialog.StartDownload">Start Download</sys:String>

    <!-- Feedback Dialog -->
    <sys:String x:Key="String.Feedback.Title">Send feedback</sys:String>
