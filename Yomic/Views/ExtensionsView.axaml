<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yomic.ViewModels"
             x:Class="Yomic.Views.ExtensionsView"
             x:DataType="vm:ExtensionsViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <UserControl.Resources>
        <DataTemplate x:Key="ExtensionItemTemplate" DataType="{x:Type vm:ExtensionItem}">
            <Border Background="{DynamicResource SidebarBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    
                    <!-- Col 1: Logo -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{Binding IconBackground}" 
                            ClipToBounds="True" VerticalAlignment="Center">
                        <Panel>
                            <TextBlock Text="{Binding IconText}" FontSize="24" FontWeight="Bold" Foreground="{Binding IconColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IconText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Image Source="{Binding IconBitmap}" Stretch="UniformToFill" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom" 
                                         Foreground="{DynamicResource PrimaryAccent}" Background="Transparent"
                                         IsVisible="{Binding IsLoadingIcon}"/>
                        </Panel>
                    </Border>
                    
                    <!-- Col 2: Info -->
                    <StackPanel Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16" VerticalAlignment="Center"/>
                            <Border Background="#20FF5555" BorderBrush="#FF5555" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding IsNsfw}">
                                <TextBlock Text="NSFW" FontSize="10" FontWeight="Bold" Foreground="#FF5555" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#25FF9800" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding HasUpdate}" ToolTip.Tip="{Binding RemoteCommitDateText}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M 20 11 A 8.1 8.1 0 0 0 4.5 9 M 4 5 v 4 h 4 M 4 13 A 8.1 8.1 0 0 0 19.5 15 M 20 19 v -4 h -4" Stroke="#FF9800" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource String.NewUpdateAvailable}" FontSize="11" FontWeight="SemiBold" Foreground="#FF9800" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                            <TextBlock Text="•" Foreground="{DynamicResource SecondaryText}" FontSize="12" IsVisible="{Binding HasFileSize}"/>
                            <TextBlock Text="{Binding FileSizeText}" Foreground="{DynamicResource SecondaryText}" FontSize="12" IsVisible="{Binding HasFileSize}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Col 3: Language Flags -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding LanguageFlags}" VerticalAlignment="Center" Margin="0,0,20,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" ClipToBounds="True" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
                                    <Image Source="{Binding}" Width="24" Height="16" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Col 4: Status / Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        
                        <!-- Update Button (For Installed Extensions with Updates available) -->
                        <Button x:CompileBindings="False" Classes="ExtBtn ExtBtnUpdate" 
                                ToolTip.Tip="{DynamicResource String.UpdateExtension}" Padding="12,6"
                                Command="{Binding DataContext.UpdateExtensionCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsInstalled"/>
                                    <Binding Path="HasUpdate"/>
                                    <Binding Path="!IsInstalling"/>
                                </MultiBinding>
                            </Button.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 20 11 A 8.1 8.1 0 0 0 4.5 9 M 4 5 v 4 h 4 M 4 13 A 8.1 8.1 0 0 0 19.5 15 M 20 19 v -4 h -4" Stroke="White" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource String.Update}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Download Button (For Uninstalled) -->
                        <Button x:CompileBindings="False" Classes="ExtBtn" Background="{DynamicResource HoverBackground}" 
                                Foreground="{DynamicResource PrimaryAccent}" ToolTip.Tip="Download &amp; Install" Padding="12,8"
                                Command="{Binding DataContext.DownloadExtensionCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!IsInstalled"/>
                                    <Binding Path="!IsDownloading"/>
                                </MultiBinding>
                            </Button.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4l0 12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource String.Download}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Downloading State -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDownloading}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <ProgressBar Value="{Binding DownloadProgress}" Maximum="1" Width="80" Height="6" CornerRadius="3" Foreground="{DynamicResource PrimaryAccent}" Background="{DynamicResource HoverBackground}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DownloadProgressText}" Foreground="{DynamicResource PrimaryAccent}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>

                        <!-- Status Indicator (Installed) -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsInstalled"/>
                                    <Binding Path="!IsInstalling"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5 12l5 5l10 -10" Stroke="{DynamicResource SuccessColor}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource String.Installed}" Foreground="{DynamicResource SuccessColor}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Actions Divider -->
                        <Border Width="1" Height="24" Background="{DynamicResource SeparatorBrush}" Margin="5,0">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsInstalled"/>
                                    <Binding Path="!IsInstalling"/>
                                </MultiBinding>
                            </Border.IsVisible>
                        </Border>

                        <!-- Verify Button -->
                        <Button x:CompileBindings="False" Classes="ExtBtn" Background="{DynamicResource HoverBackground}" 
                                Foreground="#FAB387" ToolTip.Tip="{DynamicResource String.VerifyCloudflare}" Padding="8"
                                Command="{Binding DataContext.VerifyExtensionCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="CanVerify"/>
                                    <Binding Path="!IsInstalling"/>
                                </MultiBinding>
                            </Button.IsVisible>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3 M9 11l2 2l4 -4" Stroke="#FAB387" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Uninstall Button -->
                        <Button x:CompileBindings="False" Classes="ExtBtn" Background="Transparent" Foreground="{DynamicResource ErrorColor}"
                                ToolTip.Tip="{DynamicResource String.Uninstall}" Padding="8"
                                Command="{Binding DataContext.ToggleInstallCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsInstalled"/>
                                    <Binding Path="!IsInstalling"/>
                                </MultiBinding>
                            </Button.IsVisible>
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="{DynamicResource ErrorColor}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Uninstalling State -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsInstalling}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 3a9 9 0 1 0 9 9" Stroke="{DynamicResource ErrorColor}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource String.Uninstalling}" Foreground="{DynamicResource ErrorColor}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.ExtBtn">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.ExtBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <Style Selector="Button.ExtBtnUpdate">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ExtBtnUpdate:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFA726"/>
        </Style>
        <Style Selector="Button.ExtBtnUpdate:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>


        <!-- Loader Styles (Shared Rotating Circle) -->
        <Style Selector="Border.Loader">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="RenderTransform">
                 <RotateTransform />
            </Setter>
            <Setter Property="BorderBrush">
                <ConicGradientBrush>
                    <GradientStop Offset="0" Color="LightBlue"/>
                    <GradientStop Offset="0.75" Color="LightBlue"/>
                    <GradientStop Offset="0.7501" Color="Orange"/>
                    <GradientStop Offset="1" Color="Orange"/>
                </ConicGradientBrush>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite"> 
                    <KeyFrame KeyTime="0:0:0">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame KeyTime="0:0:1">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Standard Header Action Button Style -->
        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.header-action:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>

        <!-- Disable transitions for header buttons to avoid color "lag" -->
        <Style Selector="Button.header-action TextBlock">
             <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20A6E3A1"/>
        </Style>
        <Style Selector="Button.header-action.success:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
        </Style>
        <!-- Tab Filter Style (ListBoxItem) -->
        <Style Selector="#LanguageFilterListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <!-- ListBox Global Styling for FlatList -->
        <Style Selector="ListBox.FlatList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBox.FlatList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.FlatList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.FlatList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.FlatList ListBoxItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding !IsOffline}">
        <!-- Fixed Header Area -->
        <StackPanel Grid.Row="0" Spacing="20" Margin="30,30,30,10" ZIndex="10">
            <!-- Header -->
            <StackPanel>
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21 16.008v-8.018a1.98 1.98 0 0 0 -1 -1.717l-7 -4.008a2.016 2.016 0 0 0 -2 0l-7 4.008c-.619 .355 -1 1.01 -1 1.718v8.018c0 .709 .381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7 -4.008c.619 -.355 1 -1.01 1 -1.718 M12 22v-10 M12 12l8.73 -5.04 M3.27 6.96l8.73 5.04" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource String.Extensions}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </StackPanel>
                            </StackPanel>

                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Search Box & Add Button -->
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" Width="300" HorizontalAlignment="Left"
                         Text="{Binding SearchText}"
                         Watermark="{DynamicResource String.SearchExtensions}" 
                         Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" 
                         CornerRadius="20" Padding="8,8,15,8" FontSize="13"
                         BorderThickness="0" VerticalContentAlignment="Center">
                    <TextBox.Styles>
                        <Style Selector="TextBox:focus">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
                        </Style>
                        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                         <Style Selector="TextBox:pointerover">
                             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                         </Style>
                         <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
                             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                         </Style>
                         <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark">
                             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                         </Style>
                         <Style Selector="TextBox:pointerover /template/ TextBlock#PART_Watermark">
                             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                         </Style>
                    </TextBox.Styles>
                    <TextBox.InnerLeftContent>
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                    <!-- Refresh Button -->
                    <Button Classes="header-action" Command="{Binding RefreshCommand}" ToolTip.Tip="Segarkan Ekstensi &amp; Periksa Pembaruan">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 20 11 A 8.1 8.1 0 0 0 4.5 9 M 4 5 v 4 h 4 M 4 13 A 8.1 8.1 0 0 0 19.5 15 M 20 19 v -4 h -4" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource String.Refresh}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Filter Button -->
                    <Button Classes="header-action" ToolTip.Tip="Filter Languages">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Filter By" IsEnabled="False" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                
                                <MenuItem Header="Show All" Command="{Binding SetLanguageFilterCommand}" CommandParameter="ALL">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedLanguageFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ALL'}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Bahasa Indonesia" Command="{Binding SetLanguageFilterCommand}" CommandParameter="ID">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedLanguageFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ID'}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="English" Command="{Binding SetLanguageFilterCommand}" CommandParameter="EN">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedLanguageFilter, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='EN'}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

        </StackPanel>

        <!-- Scrollable Content Area -->
        <Panel Grid.Row="1" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30,0,30,20" Spacing="25">
                    
                    <!-- Section 1: Installed Extensions -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasInstalledExtensions}">
                        <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource String.Installed}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Background="{DynamicResource HoverBackground}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InstalledCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <ListBox Classes="FlatList"
                                 ItemsSource="{Binding InstalledExtensions}" 
                                 ItemTemplate="{StaticResource ExtensionItemTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>

                    <!-- Section 2: Available Extensions -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasAvailableExtensions}">
                        <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{DynamicResource String.Available}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Background="{DynamicResource HoverBackground}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvailableCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <ListBox Classes="FlatList"
                                 ItemsSource="{Binding AvailableExtensions}" 
                                 ItemTemplate="{StaticResource ExtensionItemTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
    
            <!-- Empty State -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" Margin="0,50,0,0" IsVisible="{Binding !HasExtensions}">
                <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M21 16.008v-8.018a1.98 1.98 0 0 0 -1 -1.717l-7 -4.008a2.016 2.016 0 0 0 -2 0l-7 4.008c-.619 .355 -1 1.01 -1 1.718v8.018c0 .709 .381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7 -4.008c.619 -.355 1 -1.01 1 -1.718 M12 22v-10 M12 12l8.73 -5.04 M3.27 6.96l8.73 5.04" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource String.NoExtensionsFound}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource String.NoExtensionsFoundDesc}" Foreground="{DynamicResource SecondaryText}" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Panel>

    <!-- Loading Overlay -->
    <Border Grid.RowSpan="2" Background="{DynamicResource OverlayBackground}" IsVisible="{Binding IsBusy}">
        <Border Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 10 30 0 #50000000">
            <StackPanel Spacing="15" HorizontalAlignment="Center">
                <Border Classes="Loader" HorizontalAlignment="Center"/>
                <TextBlock Text="Processing File..." FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Border>    
        </Grid>

        <!-- Offline State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding IsOffline}">
            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a7.963 7.963 0 0 1 3.864 -2.14m4.163 .155a7.965 7.965 0 0 1 3.287 2 M3.515 9.515a12 12 0 0 1 3.544 -2.455m3.101 -.92a12 12 0 0 1 10.325 3.374 M3 3l18 18" Stroke="{DynamicResource ErrorColor}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel Spacing="8">
                <TextBlock Text="No Internet Connection" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="You are currently offline. Please check your network settings." Foreground="{DynamicResource SecondaryText}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
