<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Yomic.Views"
        x:Class="Yomic.Views.ExtensionReposDialog"
        Width="540" Height="580"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="{DynamicResource PrimaryBackground}" CornerRadius="16" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="24">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z" Fill="{DynamicResource PrimaryAccent}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource String.ExtensionRepos.Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="OnCloseClick" 
                        Background="Transparent" Foreground="{DynamicResource SecondaryText}" Padding="8,4" FontSize="16" Cursor="Hand" BorderThickness="0">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>

            <!-- Add Repo Input Box -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                <TextBox x:Name="RepoUrlTextBox" Grid.Column="0" 
                         Watermark="{DynamicResource String.ExtensionRepos.Placeholder}"
                         Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}"
                         CornerRadius="10" Padding="12,10" FontSize="13" Margin="0,0,10,0"
                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"/>
                <Button Grid.Column="1" Click="OnAddRepoClick" Content="{DynamicResource String.ExtensionRepos.AddBtn}"
                        Background="{DynamicResource PrimaryAccent}" Foreground="White"
                        Padding="16,10" CornerRadius="10" FontWeight="SemiBold" FontSize="13" Cursor="Hand"/>
            </Grid>

            <!-- Repo List -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <ScrollViewer Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="8">
                    <ItemsControl x:Name="ReposControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="views:ExtensionRepoItemViewModel">
                                <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,2">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent"/>
                                                <Path Data="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="13"/>
                                                <Border Background="#200078D4" BorderBrush="{DynamicResource PrimaryAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsOfficial}">
                                                    <TextBlock Text="{DynamicResource String.ExtensionRepos.OfficialTag}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccent}"/>
                                                </Border>
                                                <Border Background="#20FFA500" BorderBrush="Orange" BorderThickness="1" CornerRadius="4" Padding="6,1" IsVisible="{Binding !IsOfficial}">
                                                    <TextBlock Text="{DynamicResource String.ExtensionRepos.CustomTag}" FontSize="10" FontWeight="Bold" Foreground="Orange"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="OnDeleteRepoClick" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" IsVisible="{Binding !IsOfficial}" ToolTip.Tip="Delete Repository">
                                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="#FF5555" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                <Button Grid.Column="0" Click="OnResetClick" Content="{DynamicResource String.ExtensionRepos.ResetBtn}"
                        Background="Transparent" Foreground="{DynamicResource SecondaryText}" Padding="0" Cursor="Hand" BorderThickness="0" VerticalAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Grid.Column="1" Click="OnCloseClick" Content="{DynamicResource String.Category.Done}" 
                        Background="{DynamicResource HoverBackground}" Foreground="{DynamicResource PrimaryText}" 
                        Padding="24,10" CornerRadius="10" FontWeight="SemiBold" FontSize="13" Cursor="Hand" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"/>
            </Grid>
        </Grid>
    </Border>
</Window>
