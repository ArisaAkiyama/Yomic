<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yomic.ViewModels"
             xmlns:views="using:Yomic.Views"
             xmlns:helpers="clr-namespace:Yomic.Views.Helpers"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             x:Class="Yomic.Views.LibraryView"
             x:Name="root"
             x:DataType="vm:LibraryViewModel"
             Background="{DynamicResource PrimaryBackground}">
    
    <UserControl.Styles>
        <Style Selector="Border.MangaCard">
            <Setter Property="ZIndex" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.MangaCard:pointerover">
            <Setter Property="ZIndex" Value="10"/>
            <Setter Property="BoxShadow" Value="0 10 20 0 #60000000"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.MangaCard Image">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.MangaCard:pointerover Image">
            <Setter Property="RenderTransform" Value="scale(1.08)"/>
        </Style>
        
        <!-- TextBox style: black text on focus (when background becomes white) -->
        <!-- TextBox style: keep dark on focus and hover -->
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
             <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
             <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>




        <!-- Standard Header Action Button Style -->
        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.header-action:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>

        <!-- Disable transitions for header buttons to avoid color "lag" -->
        <Style Selector="Button.header-action TextBlock">
             <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>

        <!-- Source Filter Tab Style (Segmented Tabs) -->
        <Style Selector="ListBox#SourceTabsListBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="#SourceTabsListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="#SourceTabsListBox ListBoxItem:pointerover /template/ Border">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>
        <Style Selector="#SourceTabsListBox ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="#SourceTabsListBox ListBoxItem:selected /template/ Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #18000000"/>
        </Style>
        <Style Selector="#SourceTabsListBox ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Scroll Button Style -->
        <Style Selector="Button.scroll-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.scroll-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.scroll-button TextBlock">
             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="Button.scroll-button:pointerover TextBlock">
             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        
        <!-- Category Tabs ListBox Style -->
        <Style Selector="ListBox#CategoryTabsListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox#CategoryTabsListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox#CategoryTabsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#CategoryTabsListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>
    
    <Panel>
        <Grid RowDefinitions="Auto, *">
            <StackPanel Grid.Row="0" Margin="30,25,30,15">
                <!-- Row 0: Title only -->
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Header Icon -->
                        <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6l0 13 M12 6l0 13 M21 6l0 13" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                                   
                        <TextBlock Text="{DynamicResource String.LibraryHeader}" FontSize="28" FontWeight="Bold" 
                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>



                <!-- Row 1: Search Toolbar (full width, unified) -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,14,0,0" VerticalAlignment="Center">
                    <!-- Search Box - stretches to fill space -->
                    <TextBox HorizontalAlignment="Stretch"
                             Watermark="{DynamicResource String.SearchLibrary}" CornerRadius="20"
                             Text="{Binding SearchText}"
                             Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0"
                             Padding="8,8,15,8" VerticalContentAlignment="Center" FontSize="13">
                        <TextBox.InnerLeftContent>
                              <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="12,0,0,0">
                                  <Canvas Width="24" Height="24">
                                      <Path Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                  </Canvas>
                              </Viewbox>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <!-- Action Buttons - right side of toolbar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <!-- Filter Button -->
                        <Button Classes="header-action" ToolTip.Tip="Sort and Filter">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <!-- Filter Section -->
                                    <MenuItem Header="Filter by">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                        <MenuItem Header="Show All" Command="{Binding SetFilterModeCommand}" CommandParameter="{x:Static vm:LibraryFilterMode.All}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryFilterMode.All}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Unread Only" Command="{Binding SetFilterModeCommand}" CommandParameter="{x:Static vm:LibraryFilterMode.UnreadOnly}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryFilterMode.UnreadOnly}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ongoing Only" Command="{Binding SetFilterModeCommand}" CommandParameter="{x:Static vm:LibraryFilterMode.OngoingOnly}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryFilterMode.OngoingOnly}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Completed Only" Command="{Binding SetFilterModeCommand}" CommandParameter="{x:Static vm:LibraryFilterMode.CompletedOnly}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryFilterMode.CompletedOnly}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Downloaded Only" Command="{Binding SetFilterModeCommand}" CommandParameter="{x:Static vm:LibraryFilterMode.DownloadedOnly}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedFilterMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryFilterMode.DownloadedOnly}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <!-- Browse By Section -->
                                    <MenuItem Header="Browse by" ItemsSource="{Binding AvailableSources}">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                        <MenuItem.Styles>
                                            <Style Selector="MenuItem > MenuItem" x:DataType="vm:LibraryViewModel+LibrarySourceFilterItem">
                                                <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SetSourceFilterCommand}"/>
                                                <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                            </Style>
                                        </MenuItem.Styles>
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate DataType="vm:LibraryViewModel+LibrarySourceFilterItem" x:CompileBindings="False">
                                                <Grid ColumnDefinitions="24, 24, *">
                                                    <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                                                        <Viewbox.IsVisible>
                                                            <MultiBinding Converter="{x:Static vm:StatusToColorConverter.StringEqualityConverter}">
                                                                <Binding Path="$parent[UserControl].DataContext.SelectedSourceFilter" />
                                                                <Binding Path="Name" />
                                                            </MultiBinding>
                                                        </Viewbox.IsVisible>
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M5 12l5 5l10 -10" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <!-- Icon -->
                                                    <Border Grid.Column="1" Width="18" Height="18" Margin="0,0,6,0" CornerRadius="4" Background="{Binding IconColor}" ClipToBounds="True" VerticalAlignment="Center" IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <Panel>
                                                            <TextBlock Text="{Binding IconText}" Foreground="{Binding IconForeground}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IconText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                            <Image Source="{Binding IconBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>

                                    <!-- Sort Section -->
                                    <MenuItem Header="Sort by">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M3 9l4 -4l4 4 M7 5v14 M21 15l-4 4l-4 -4 M17 19v-14" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                        <MenuItem Header="Last Read (Recently)" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:LibrarySortMode.LastReadDesc}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedSortMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibrarySortMode.LastReadDesc}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Most Unread" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:LibrarySortMode.UnreadCountDesc}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedSortMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibrarySortMode.UnreadCountDesc}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Date Modified" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:LibrarySortMode.DateModified}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedSortMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibrarySortMode.DateModified}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="A → Z" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:LibrarySortMode.TitleAsc}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedSortMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibrarySortMode.TitleAsc}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Z → A" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static vm:LibrarySortMode.TitleDesc}">
                                            <MenuItem.Icon>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedSortMode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibrarySortMode.TitleDesc}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="Filter by Genre" StaysOpenOnClick="True">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M7.5 7.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M3 6a3 3 0 0 1 3 -3h4a3 3 0 0 1 2.12 .88l8 8a3 3 0 0 1 0 4.24l-4 4a3 3 0 0 1 -4.24 0l-8 -8A3 3 0 0 1 3 10V6z" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                        <MenuItem.Styles>
                                            <Style Selector="MenuItem > MenuItem">
                                                <Setter Property="Template">
                                                    <ControlTemplate>
                                                        <ContentPresenter Content="{TemplateBinding Header}"
                                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                                    </ControlTemplate>
                                                </Setter>
                                            </Style>
                                        </MenuItem.Styles>
                                        <Grid RowDefinitions="Auto, *" Width="180" Margin="12,8,12,8">
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                                <TextBlock Text="Filter by Genre" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                                                <Button Grid.Column="1" Content="Clear" 
                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentColor}"
                                                        Command="{Binding ClearGenreFilterCommand}" 
                                                        Padding="4,2" FontSize="12"/>
                                            </Grid>
                                            
                                            <ScrollViewer Grid.Row="1" MaxHeight="250" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding AvailableGenres}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:LibraryViewModel+GenreFilterItem" x:CompileBindings="False">
                                                            <CheckBox Content="{Binding Name}" 
                                                                      IsChecked="{Binding IsSelected}" 
                                                                      Margin="0"
                                                                      Padding="8,0,0,0" MinHeight="28"
                                                                      HorizontalAlignment="Stretch"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Manage Categories..." Command="{Binding ManageCategoriesCommand}">
                                        <MenuItem.Icon>
                                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c.996 .608 2.296 .07 2.572 -1.065z M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding IsOnline}"
                                Classes="header-action"
                                ToolTip.Tip="Sync Library">
                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Toggle View Mode Button -->
                        <Button Command="{Binding ToggleViewModeCommand}"
                                Classes="header-action"
                                ToolTip.Tip="Toggle View Mode (Grid/List)">
                            <Panel>
                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsListView}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M9 6l11 0 M9 12l11 0 M9 18l11 0 M5 6l0 .01 M5 12l0 .01 M5 18l0 .01" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsListView}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M14 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>
                
                <!-- Category Tabs -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,16,0,0" IsVisible="{Binding HasCategories}">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="CategoryTabsListBox" 
                                 ItemsSource="{Binding CategoryTabs}" 
                                 SelectedItem="{Binding SelectedCategoryTab}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <!-- Unselected Tab -->
                                <Style Selector="ListBoxItem Border#TabBorder">
                                    <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                    <Setter Property="Opacity" Value="0.85"/>
                                </Style>
                                <!-- Selected Tab -->
                                <Style Selector="ListBoxItem:selected Border#TabBorder">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryAccent}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccent}"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected TextBlock#TabText">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                                <!-- Pointer Over -->
                                <Style Selector="ListBoxItem:pointerover Border#TabBorder">
                                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:CategoryTabItem">
                                    <Border x:Name="TabBorder"
                                            CornerRadius="16" 
                                            BorderThickness="1"
                                            Padding="14,6"
                                            DragDrop.AllowDrop="True"
                                            DragDrop.DragOver="OnTabDragOver"
                                            DragDrop.Drop="OnTabDrop">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding ColorBrush}" IsVisible="{Binding ShowColorDot}"/>
                                            <TextBlock x:Name="TabText" Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    <Button Grid.Column="1" Classes="header-action" Command="{Binding ManageCategoriesCommand}" VerticalAlignment="Center" ToolTip.Tip="Manage Categories" Margin="10,0,0,0" IsVisible="False">
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c.996 .608 2.296 .07 2.572 -1.065z M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Virtualized ListBox -->
            <ListBox x:Name="LibraryListBox" Grid.Row="1" ItemsSource="{Binding LibraryItems}" 
                     Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.AllowAutoHide="False"
                     IsVisible="{Binding ShowGridView}">
                <ListBox.Styles>
                    <!-- Disable default ListBoxItem selection styles -->
                    <Style Selector="ListBoxItem">
                         <Setter Property="Padding" Value="0"/>
                         <Setter Property="Margin" Value="0"/>
                         <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="175" ItemHeight="310" HorizontalAlignment="Center"/> 
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MangaItem">
                         <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="10,0,10,20"
                                 Command="{Binding DataContext.OpenMangaCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                 CommandParameter="{Binding}">
                              <Button.Styles>
                                 <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                     <Setter Property="Background" Value="Transparent"/>
                                     <Setter Property="Opacity" Value="1.0"/>
                                 </Style>
                              </Button.Styles>
                             
                                <StackPanel Width="150" Spacing="8">
                                <!-- Cover Image -->
                                <Border Classes="MangaCard" Height="225" CornerRadius="12" 
                                        Background="{DynamicResource SidebarBackground}" ClipToBounds="True"
                                        BoxShadow="0 4 10 0 #40000000"
                                        PointerPressed="OnMangaCardPointerPressed"
                                        PointerMoved="OnMangaCardPointerMoved"
                                        PointerReleased="OnMangaCardPointerReleased">
                                    
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Mark as Read"
                                                      x:CompileBindings="False"
                                                      Command="{Binding #root.DataContext.MarkAsReadCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Mark as Unread"
                                                      x:CompileBindings="False"
                                                      Command="{Binding #root.DataContext.MarkAsUnreadCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Edit Categories..."
                                                      x:CompileBindings="False"
                                                      Command="{Binding #root.DataContext.EditMangaCategoriesCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>

                                            <MenuItem Header="Delete All Downloads" Foreground="#FF5555"
                                                      IsVisible="{Binding IsDownloadedBadgeVisible}"
                                                      x:CompileBindings="False"
                                                      Command="{Binding #root.DataContext.DeleteMangaDownloadsCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Delete from Disk" Foreground="#FF5555"
                                                      x:CompileBindings="False"
                                                      Command="{Binding #root.DataContext.DeleteMangaCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                
                                    <Grid>
                                         <Image helpers:SecureImageLoader.Url="{Binding CoverUrl}" 
                                                helpers:SecureImageLoader.DecodeWidth="300"
                                                Stretch="UniformToFill"/>
                                        
                                        <!-- NEW Ribbon (Top Left Diagonal) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                Width="100" Height="18" Margin="-32,9,0,0"
                                                Background="#EF4444"
                                                IsVisible="{Binding IsNewBadgeVisible}">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-45"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{DynamicResource String.Badge.New}" 
                                                       FontSize="8" FontWeight="900" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                        </Border>

                                        <!-- Unread Badge -->
                                        <Border Background="{DynamicResource PrimaryAccent}" CornerRadius="6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="8" Padding="6,2"
                                                IsVisible="{Binding UnreadCount, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="#FFFFFF" 
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Download Badge (Bottom Right) -->
                                        <Border Background="#0066CC" CornerRadius="6" 
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="8" Padding="6,2"
                                                IsVisible="{Binding IsDownloadedBadgeVisible}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Viewbox Width="10" Height="10" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4l0 12" Stroke="#FFFFFF" StrokeThickness="3.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DownloadedCount}" Foreground="#FFFFFF" 
                                                            FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- Title Below Image -->
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" 
                                           TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                           FontSize="13" FontWeight="SemiBold" MaxLines="2"
                                           ToolTip.Tip="{Binding Title}"/>

                                <!-- Metadata: Source + Last Read -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0">
                                    <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryText}" 
                                               FontSize="11" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="·" Foreground="{DynamicResource SecondaryText}" FontSize="11" Opacity="0.5"
                                               IsVisible="{Binding LastReadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="{Binding LastReadTime}" Foreground="{DynamicResource SecondaryText}" 
                                               FontSize="11" Opacity="0.6" MaxLines="1"
                                               IsVisible="{Binding LastReadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </StackPanel>
                         </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Virtualized List ListBox -->
            <ListBox x:Name="LibraryListModeBox" Grid.Row="1" ItemsSource="{Binding LibraryItems}" 
                     Background="Transparent" BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     IsVisible="{Binding ShowListView}">
                <ListBox.Styles>
                    <!-- Disable default ListBoxItem selection styles -->
                    <Style Selector="ListBoxItem">
                         <Setter Property="Padding" Value="0"/>
                         <Setter Property="Margin" Value="0"/>
                         <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical" Margin="30,0,30,0"/> 
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MangaItem">
                         <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="0,0,0,4"
                                 Command="{Binding DataContext.OpenMangaCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                 CommandParameter="{Binding}"
                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                             <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                </Style>
                             </Button.Styles>
                             
                             <Border CornerRadius="8" Padding="8" Background="Transparent"
                                     PointerPressed="OnMangaCardPointerPressed"
                                     PointerMoved="OnMangaCardPointerMoved"
                                     PointerReleased="OnMangaCardPointerReleased">
                                 <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Mark as Read"
                                                  x:CompileBindings="False"
                                                  Command="{Binding #root.DataContext.MarkAsReadCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Mark as Unread"
                                                  x:CompileBindings="False"
                                                  Command="{Binding #root.DataContext.MarkAsUnreadCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Edit Categories..."
                                                  x:CompileBindings="False"
                                                  Command="{Binding #root.DataContext.EditMangaCategoriesCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                         <MenuItem Header="Delete All Downloads" Foreground="#FF5555"
                                                   IsVisible="{Binding IsDownloadedBadgeVisible}"
                                                   x:CompileBindings="False"
                                                   Command="{Binding #root.DataContext.DeleteMangaDownloadsCommand}"
                                                   CommandParameter="{Binding}"/>
                                         <MenuItem Header="Delete from Disk" Foreground="#FF5555"
                                                   x:CompileBindings="False"
                                                   Command="{Binding #root.DataContext.DeleteMangaCommand}"
                                                   CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid ColumnDefinitions="60, 16, *, Auto">
                                    <!-- Tiny Cover Image -->
                                    <Border Grid.Column="0" Height="80" Width="60" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SidebarBackground}">
                                        <Image helpers:SecureImageLoader.Url="{Binding CoverUrl}" 
                                               helpers:SecureImageLoader.DecodeWidth="300"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                    
                                    <!-- Text Info -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" 
                                                   TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                                   FontSize="14" FontWeight="SemiBold" MaxLines="1"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryText}" 
                                                       FontSize="12" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="·" Foreground="{DynamicResource SecondaryText}" FontSize="12" Opacity="0.5"
                                                       IsVisible="{Binding LastReadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding LastReadTime}" Foreground="{DynamicResource SecondaryText}" 
                                                       FontSize="12" Opacity="0.6" MaxLines="1"
                                                       IsVisible="{Binding LastReadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Badges -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- NEW Badge (List view - keep flat pill) -->
                                        <Border Background="#EF4444" CornerRadius="4" Padding="6,2"
                                                IsVisible="{Binding IsNewBadgeVisible}">
                                            <TextBlock Text="{DynamicResource String.Badge.New}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <!-- Unread Badge -->
                                        <Border Background="{DynamicResource PrimaryAccent}" CornerRadius="4" Padding="6,2" MinWidth="24"
                                                IsVisible="{Binding UnreadCount, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="#FFFFFF" 
                                                       FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <!-- Download Badge -->
                                        <Border Background="#0066CC" CornerRadius="4" Padding="6,2"
                                                IsVisible="{Binding IsDownloadedBadgeVisible}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Viewbox Width="10" Height="10" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4l0 12" Stroke="#FFFFFF" StrokeThickness="3.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding DownloadedCount}" Foreground="#FFFFFF" 
                                                            FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                             </Border>
                         </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Sync Overlay (Skeleton Grid Loading View) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsRefreshing}" Margin="30,0,30,0">
                <WrapPanel Orientation="Horizontal" ItemWidth="175" ItemHeight="310" HorizontalAlignment="Center">
                    <!-- 14 Skeleton cards to fill the screen -->
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="80" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="70" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="130" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="90" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="100" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="60" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="125" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="85" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="115" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="75" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="105" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="65" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="80" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="70" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="95" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="65" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="115" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="75" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="105" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="60" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="125" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="85" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="70" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                </WrapPanel>
            </ScrollViewer>

            <!-- Skeleton Loading State (Initial Load) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding IsLoading}" Margin="30,0,30,0">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="80" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="70" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="130" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="90" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="100" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="60" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="125" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="85" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="115" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="75" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="105" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="65" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="80" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="70" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="95" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="65" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="115" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="75" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="105" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="60" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="125" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="85" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" Width="150"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" HorizontalAlignment="Left"/>
                        <Border Classes="SkeletonText" Width="70" Height="10" HorizontalAlignment="Left"/>
                    </StackPanel>
                </WrapPanel>
            </ScrollViewer>
        </Grid>

        <!-- Empty State (Only if NOT loading and IS empty) -->
        <!-- Case 1: Library Empty (No Items) -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
             <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsLibraryEmpty"/>
                    <Binding Path="!IsLoading"/>
                </MultiBinding>
             </StackPanel.IsVisible>

            <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M5 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1 M9 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1 M14 8h4a1 1 0 0 1 1 1v11a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1v-11a1 1 0 0 1 1 -1 M6 8h2 M10 8h2 M16 12h2 M16 16h2" Stroke="{DynamicResource HoverBackground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
            </Viewbox>
            <TextBlock Text="{DynamicResource String.LibraryEmpty}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource String.LibraryEmptyDesc}" FontSize="16" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
            
            <Button Content="{DynamicResource String.BrowseSources}" Classes="NavBtn" Background="#0078D7" Foreground="#FFFFFF" Padding="20,10" CornerRadius="8"
                    Command="{Binding GoToBrowseCommand}" 
                    HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Case 2: No Search Results -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
             <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasNoResults"/>
                    <Binding Path="!IsLoading"/>
                </MultiBinding>
             </StackPanel.IsVisible>

            <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 5.899 -1.096 M3 6a9 9 0 0 1 2.114 -.884m3.8 -.21c1.07 .17 2.116 .534 3.086 1.094a9 9 0 0 1 9 0 M3 6v13 M12 6v2m0 4v7 M21 6v11 M3 3l18 18" Stroke="#45475A" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
            </Viewbox>
            <TextBlock Text="{DynamicResource String.NoResultsFound}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource String.NoResultsFoundDesc}" FontSize="16" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Bottom Floating Lazy Loading Bar -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,24" Padding="18,10"
                Background="#E0181825" CornerRadius="20"
                BoxShadow="0 4 16 0 #50000000"
                IsVisible="{Binding IsLoadingMore}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <helpers:LoadingArcs Width="22" Height="22"/>
                <TextBlock Text="{DynamicResource String.LoadingMore}" 
                           Foreground="{DynamicResource PrimaryText}" 
                           FontSize="13" FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Panel>
</UserControl>
