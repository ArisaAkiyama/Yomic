<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Yomic.ViewModels"
             xmlns:helpers="using:Yomic.Views.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Yomic.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel"
             Background="{DynamicResource PrimaryBackground}">
    
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <!-- Card Style (Mihon-like flat row) -->
        <Style Selector="Border.UpdateCard">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.UpdateCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- Dimmed Text for Read Chapters -->
        <Style Selector="TextBlock.read">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>



        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.header-action:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- Online Content -->
        <Panel IsVisible="{Binding !IsOffline}">
            <Grid RowDefinitions="Auto, *">
                <!-- Header (Fixed) -->
                <StackPanel Grid.Row="0" Margin="30,25,30,15">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource String.Updates}" FontSize="28" FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                            
                        </StackPanel>

                        <!-- Right Side: Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasItems}">
                            <!-- Clear Cache / Updates Button -->
                            <Button Command="{Binding ClearUpdatesCommand}"
                                    Classes="header-action"
                                    ToolTip.Tip="{DynamicResource String.Updates.ClearAll}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource String.Updates.ClearAll}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <!-- Refresh Button -->
                            <Button Command="{Binding RefreshCommand}"
                                    Classes="header-action"
                                    ToolTip.Tip="{DynamicResource String.Updates.Sync}">
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Global Update Education Warning -->
                    <Border IsVisible="False" Background="#1AFFB900" BorderBrush="#FFB900" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 9v4 M12 17h.01 M12 3a9 9 0 1 0 9 9a9 9 0 0 0 -9 -9" Stroke="#FFB900" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource String.Updates.Warning}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Margin="30,0,30,30">

                    <!-- Updates List (Grouped) -->
                    <ItemsControl ItemsSource="{Binding GroupedUpdates}" IsVisible="{Binding !IsEmpty}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,25" HorizontalAlignment="Stretch">
                                    <!-- Group Header -->
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,8">
                                         <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryAccent}" Opacity="0.9"/>
                                    </Border>
                                    
                                    <!-- Items in Group -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button x:CompileBindings="False"
                                                        Command="{Binding DataContext.OpenChapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="0" Margin="0,0,0,8">
                                                    <Button.Template>
                                                        <ControlTemplate>
                                                            <ContentPresenter Content="{TemplateBinding Content}"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{DynamicResource String.Updates.MarkPreviousRead}" 
                                                                      Command="{Binding DataContext.MarkPrevReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    
                                                    <Border Classes="UpdateCard" CornerRadius="12" Padding="12,10" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="56, *, Auto">
                                                            <!-- Col 1: Cover (Portrait 56x80) -->
                                                            <Border Grid.Column="0" Width="56" Height="80" CornerRadius="6" ClipToBounds="True" Background="#181825" VerticalAlignment="Center">
                                                                <Image helpers:SecureImageLoader.Url="{Binding MangaRef.ThumbnailUrl}"
                                                                       helpers:SecureImageLoader.DecodeWidth="300"
                                                                       Stretch="UniformToFill" />
                                                            </Border>

                                                            <!-- Col 2: Info -->
                                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0" RowDefinitions="Auto, Auto">
                                                                <!-- Title -->
                                                                <TextBlock Grid.Row="0" Classes.read="{Binding IsRead}"
                                                                           Text="{Binding MangaRef.Title}" 
                                                                           Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="15"
                                                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                           Margin="0,0,0,6"
                                                                           VerticalAlignment="Center"/>
                                                                
                                                                <!-- Chapter Name Row -->
                                                                <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                                                    <!-- Unread Dot (Mihon style) -->
                                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" 
                                                                            Background="{DynamicResource PrimaryAccent}" 
                                                                            Margin="0,0,8,0" VerticalAlignment="Center" 
                                                                            IsVisible="{Binding !IsRead}"/>
                                                                    
                                                                    <!-- Chapter Title -->
                                                                    <TextBlock Grid.Column="1" Classes.read="{Binding IsRead}"
                                                                               Text="{Binding Title}" 
                                                                               Foreground="{DynamicResource SecondaryText}" FontSize="13" 
                                                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                               VerticalAlignment="Center"/>

                                                                    <!-- Badge: +N more -->
                                                                    <Border Grid.Column="2" 
                                                                            Background="{DynamicResource PrimaryAccent}" 
                                                                            CornerRadius="6" 
                                                                            Padding="6,2" 
                                                                            Margin="8,0,0,0" 
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding HasAdditionalChapters}">
                                                                        <TextBlock Text="{Binding AdditionalChaptersText}" 
                                                                                   Foreground="#FFFFFF" 
                                                                                   FontSize="10" 
                                                                                   FontWeight="Bold"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Col 3: Meta (Timestamp) -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Date}" 
                                                                       Foreground="{DynamicResource SecondaryText}" FontSize="12" 
                                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,5,0"
                                                                       Opacity="0.8" ToolTip.Tip="{Binding FullDateString}"/>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </Grid>

             <!-- Empty State (Centered Overlay) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding IsEmpty}">
                  <!-- Case 1: Library Is Empty -->
                   <StackPanel Spacing="10" IsVisible="{Binding IsLibraryEmpty}">
                       <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                           <Canvas Width="24" Height="24">
                               <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="#45475A" StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                           </Canvas>
                       </Viewbox>
                       <TextBlock Text="{DynamicResource String.Updates.Empty}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                       <TextBlock Text="{DynamicResource String.Updates.EmptyDesc}" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                       <Button Command="{Binding GoToLibraryCommand}" Content="{DynamicResource String.Welcome.GoToLibrary}" HorizontalAlignment="Center" Background="#0078D7" Foreground="#FFFFFF" Padding="20,10" CornerRadius="8" Margin="0,15,0,0"/>
                   </StackPanel>

                  <!-- Case 2: Library Has Items but No Updates -->
                   <StackPanel Spacing="10" IsVisible="{Binding !IsLibraryEmpty}">
                        <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.6"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource String.Updates.NoRecent}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String.Updates.NoRecentDesc}" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                        <Button Command="{Binding RefreshCommand}" Content="{DynamicResource String.Updates.CheckNow}" HorizontalAlignment="Center" Background="{DynamicResource PrimaryAccent}" Foreground="#FFFFFF" Padding="24,10" CornerRadius="20" FontWeight="SemiBold" FontSize="13" Margin="0,15,0,0"/>
                   </StackPanel>
            </StackPanel>
        </Panel>

    <!-- Offline State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding IsOffline}">
            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a8 8 0 0 1 11.314 0 M3.515 9.515c4.686 -4.686 12.284 -4.686 16.97 0 M3 3l18 18" Stroke="#F38BA8" StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource String.Updates.Offline}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource String.Updates.OfflineDesc}" Foreground="{DynamicResource SecondaryText}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Real-Time Sync Progress Overlay Pill (Progress Bar & Percentage) -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,24" Padding="20,12" MinWidth="260"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="1"
                CornerRadius="20"
                BoxShadow="0 8 24 0 #60000000"
                IsVisible="{Binding IsSyncProgressVisible}">
            <StackPanel Spacing="8" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <helpers:LoadingArcs Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String.UpdatingLibraryProgress}" 
                                   Foreground="{DynamicResource PrimaryText}" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SyncProgressText}" 
                               Foreground="{DynamicResource PrimaryAccent}" 
                               FontSize="13" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                
                <ProgressBar Value="{Binding SyncProgressPercentage}" Maximum="100" 
                             Height="4" CornerRadius="2" 
                             Foreground="{DynamicResource PrimaryAccent}" 
                             Background="{DynamicResource HoverBackground}"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
