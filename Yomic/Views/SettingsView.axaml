<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yomic.ViewModels"
             x:Class="Yomic.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource PrimaryBackground}">
    

    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="30" Margin="30,20">
             <!-- Header -->
             <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center" Margin="0,0,0,10">
                <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c.996 .608 2.296 .07 2.572 -1.065z M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{DynamicResource String.Settings}" FontSize="32" FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- General Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                     <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z M7 20h10 M9 16v4 M15 16v4" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                      <TextBlock Text="{DynamicResource String.General}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                
                <StackPanel Spacing="6">
                    <!-- Item 1 -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.DarkMode}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.DarkModeDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsEnabled="{Binding !IsThemeChanging}" IsChecked="{Binding IsDarkMode}" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>
                    
                    <!-- Item 2 -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{DynamicResource String.OfflineMode}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                    <!-- Status Badges -->
                                    <Panel VerticalAlignment="Center">
                                        <Border Background="#2000C853" CornerRadius="8" Padding="8,2" IsVisible="{Binding !IsOfflineMode}">
                                            <TextBlock Text="ONLINE" Foreground="#00C853" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#20FF5555" CornerRadius="8" Padding="8,2" IsVisible="{Binding IsOfflineMode}">
                                            <TextBlock Text="OFFLINE" Foreground="#FF5555" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String.OfflineModeDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOfflineMode}" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Show NSFW Sources -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.ShowNsfwSources}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.ShowNsfwSourcesDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowNsfwSources}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Item 3 -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.AutoUpdate}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.AutoUpdateDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckAppUpdateOnStart}" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Language Selection -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource String.AppLanguage}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.AppLanguageDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding AppLanguageIndex}" Width="160" VerticalAlignment="Center">
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="Bahasa Indonesia"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Network Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                     <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                      <TextBlock Text="{DynamicResource String.Network}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                <StackPanel Spacing="6">

                    <!-- DNS over HTTPS -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.DnsOverHttps}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.DnsOverHttpsDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DnsOverHttpsProvider}" Width="150" VerticalAlignment="Center" CornerRadius="8">
                                <ComboBoxItem Content="{DynamicResource String.Disabled}"/>
                                <ComboBoxItem>Cloudflare</ComboBoxItem>
                                <ComboBoxItem>Google</ComboBoxItem>
                                <ComboBoxItem>AdGuard</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Source Status Check Interval -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.SourceStatusCheckInterval}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.SourceStatusCheckIntervalDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SourceStatusRefreshIntervalIndex}" Width="150" VerticalAlignment="Center" CornerRadius="8">
                                <ComboBoxItem Content="{DynamicResource String.Interval.1Min}"/>
                                <ComboBoxItem Content="{DynamicResource String.Interval.3Min}"/>
                                <ComboBoxItem Content="{DynamicResource String.Interval.5Min}"/>
                                <ComboBoxItem Content="{DynamicResource String.Interval.10Min}"/>
                                <ComboBoxItem Content="{DynamicResource String.Interval.30Min}"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                      <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6v13 M12 6v13 M21 6v13" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                      <TextBlock Text="{DynamicResource String.LibraryHeader}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                
                <StackPanel Spacing="6">
                    <!-- Item 1 -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.AutoSyncLibrary}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.AutoSyncLibraryDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding UpdateOnStart}" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Smart Update -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{DynamicResource String.SmartUpdate}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                    <Border Background="#20E8A0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource String.Recommended}" FontSize="10" FontWeight="Bold" Foreground="#121212"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource String.SmartUpdateDesc}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseSmartUpdate}" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>

                    <!-- Item 2 -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.BackgroundAutoUpdate}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.BackgroundAutoUpdateDesc}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding AutoUpdateIntervalIndex}" Width="150" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource String.UpdateIntervalOff}"/>
                                <ComboBoxItem Content="{DynamicResource String.UpdateInterval6h}"/>
                                <ComboBoxItem Content="{DynamicResource String.UpdateInterval12h}"/>
                                <ComboBoxItem Content="{DynamicResource String.UpdateInterval24h}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Refresh Library Covers -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.RefreshLibraryCovers}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.RefreshLibraryCoversDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RefreshLibraryCoversCommand}" 
                                    IsEnabled="{Binding !IsRefreshingCovers}"
                                    Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" 
                                    Foreground="{DynamicResource PrimaryText}" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                     VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="M 12 2 A 10 10 0 1 1 2 12" Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" 
                                          Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="50%,50%"
                                          IsVisible="{Binding IsRefreshingCovers}" VerticalAlignment="Center">
                                        <Path.Styles>
                                            <Style Selector="Path">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                                        <KeyFrame KeyTime="0:0:0">
                                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                                        </KeyFrame>
                                                        <KeyFrame KeyTime="0:0:0.8">
                                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Path.Styles>
                                    </Path>
                                    <TextBlock Text="{DynamicResource String.Refresh}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Security Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                     <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                      <TextBlock Text="{DynamicResource String.Security}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                 <StackPanel Spacing="6">
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.BlurExplicitCovers}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.BlurExplicitCoversDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SecureScreen}" OnContent="" OffContent=""/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>


            <!-- Reader Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                     <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6v13 M12 6v13 M21 6v13" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                      <TextBlock Text="{DynamicResource String.Reader}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                 <StackPanel Spacing="6">
                    <!-- Preload Next Chapter -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource String.PreloadNextChapter}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource String.PreloadNextChapterDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PreloadNextChapter}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Auto Download Next Chapter -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource String.AutoDownloadNextChapter}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource String.AutoDownloadNextChapterDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadNextChapter}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Skip Filtered Chapters -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource String.SkipFilteredChapters}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource String.SkipFilteredChaptersDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipFilteredChapters}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Reader Performance Mode -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource String.ReaderPerformanceMode}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource String.ReaderPerformanceModeDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReaderPerformanceMode}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Max Reader Cache Size -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource String.MaxReaderCacheSize}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16" HorizontalAlignment="Left"/>
                                <TextBlock Text="{DynamicResource String.MaxReaderCacheSizeDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding MaxCacheSizeIndex}" Width="150" VerticalAlignment="Center" CornerRadius="8">
                                <ComboBoxItem Content="{DynamicResource String.Disabled}"/>
                                <ComboBoxItem>250 MB</ComboBoxItem>
                                <ComboBoxItem>500 MB</ComboBoxItem>
                                <ComboBoxItem>1 GB</ComboBoxItem>
                                <ComboBoxItem>2 GB</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Data & Storage Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                      <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M12 6m-8 0a8 3 0 1 0 16 0a8 3 0 1 0 -16 0 M4 6v6a8 3 0 0 0 16 0v-6 M4 12v6a8 3 0 0 0 16 0v-6" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                      <TextBlock Text="{DynamicResource String.DataStorage}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                 <StackPanel Spacing="6">
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.CreateBackup}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.CreateBackupDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock Text="{Binding LastBackupInfo}" 
                                           FontSize="11" Foreground="{DynamicResource SecondaryText}" Opacity="0.7" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding BackupDataCommand}"
                                    IsEnabled="{Binding !IsBackingUp}"
                                    Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" 
                                    Foreground="{DynamicResource PrimaryText}" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="M 12 2 A 10 10 0 1 1 2 12" Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" 
                                          Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="50%,50%"
                                          IsVisible="{Binding IsBackingUp}" VerticalAlignment="Center">
                                        <Path.Styles>
                                            <Style Selector="Path">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                                        <KeyFrame KeyTime="0:0:0">
                                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                                        </KeyFrame>
                                                        <KeyFrame KeyTime="0:0:0.8">
                                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Path.Styles>
                                    </Path>
                                    <TextBlock Text="{DynamicResource String.Backup}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.RestoreBackup}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.RestoreBackupDesc}" 
                                           FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RestoreDataCommand}"
                                    IsEnabled="{Binding !IsRestoring}"
                                    Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" 
                                    Foreground="{DynamicResource PrimaryText}" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Data="M 12 2 A 10 10 0 1 1 2 12" Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" 
                                          Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="50%,50%"
                                          IsVisible="{Binding IsRestoring}" VerticalAlignment="Center">
                                        <Path.Styles>
                                            <Style Selector="Path">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                                        <KeyFrame KeyTime="0:0:0">
                                                            <Setter Property="RotateTransform.Angle" Value="0"/>
                                                        </KeyFrame>
                                                        <KeyFrame KeyTime="0:0:0.8">
                                                            <Setter Property="RotateTransform.Angle" Value="360"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Path.Styles>
                                    </Path>
                                    <TextBlock Text="{DynamicResource String.Restore}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Clear Cache & Cookies -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000" IsVisible="False">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.ClearCacheCookies}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.ClearCacheCookiesDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String.ClearCache}" Command="{Binding ClearCacheCookiesCommand}"
                                    Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" 
                                    Foreground="{DynamicResource PrimaryText}" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                     VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </Border>

                    </StackPanel>
            </StackPanel>

            <!-- Advanced Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M7 8l-4 4l4 4 M17 8l4 4l-4 4 M14 4l-4 16" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource String.Advanced}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>

                <StackPanel Spacing="6">

                    <!-- Database Statistics -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,18" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{DynamicResource String.DatabaseStatistics}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource String.DatabaseStatisticsDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                                </StackPanel>
                                <!-- Optimize Button -->
                                <Button Grid.Column="1" Command="{Binding OptimizeDatabaseCommand}"
                                        IsEnabled="{Binding !IsOptimizingDb}"
                                        Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource PrimaryText}" CornerRadius="8" Padding="16,8" FontWeight="SemiBold" FontSize="13"
                                        VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Run VACUUM, REINDEX and ANALYZE to compact and speed up the database">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="M12 2 A 10 10 0 1 1 2 12" Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2"
                                              Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="50%,50%"
                                              IsVisible="{Binding IsOptimizingDb}" VerticalAlignment="Center">
                                            <Path.Styles>
                                                <Style Selector="Path">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                                            <KeyFrame KeyTime="0:0:0">
                                                                <Setter Property="RotateTransform.Angle" Value="0"/>
                                                            </KeyFrame>
                                                            <KeyFrame KeyTime="0:0:0.8">
                                                                <Setter Property="RotateTransform.Angle" Value="360"/>
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </Path.Styles>
                                        </Path>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding !IsOptimizingDb}">
                                             <Canvas Width="24" Height="24">
                                                 <Path Data="M13 3l0 7l6 0l-8 11l0 -7l-6 0z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                             </Canvas>
                                         </Viewbox>
                                        <TextBlock Text="{DynamicResource String.OptimizeDb}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Stats Grid -->
                            <Border Background="{DynamicResource PrimaryBackground}" CornerRadius="6" Padding="16,12">
                                <Grid ColumnDefinitions="*, 1, *, 1, *, 1, *">
                                    <!-- Manga -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding DbStatsManga}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource String.Manga}" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource SeparatorBrush}" Margin="0,4"/>
                                    <!-- Chapters -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding DbStatsChapters}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource String.Chapters}" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Background="{DynamicResource SeparatorBrush}" Margin="0,4"/>
                                    <!-- History -->
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding DbStatsHistory}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource String.HistoryLabel}" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="5" Width="1" Background="{DynamicResource SeparatorBrush}" Margin="0,4"/>
                                    <!-- DB Size -->
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding DbStatsSize}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource String.DbSize}" FontSize="11" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Export Logs -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.ExportAppLogs}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.ExportAppLogsDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Command="{Binding ExportLogsCommand}"
                                        Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                        Foreground="{DynamicResource PrimaryText}" CornerRadius="8" Padding="16,8" FontWeight="SemiBold" FontSize="13"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                         <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                             <Canvas Width="24" Height="24">
                                                 <Path Data="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2 M12 14m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M14 4l0 4l-4 0l0 -4" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                             </Canvas>
                                         </Viewbox>
                                        <TextBlock Text="{DynamicResource String.ExportLogs}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearLogsCommand}"
                                        Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                        Foreground="#ef4444" CornerRadius="8" Padding="16,8" FontWeight="SemiBold" FontSize="13"
                                        Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                         <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                             <Canvas Width="24" Height="24">
                                                 <Path Data="M4 7h16 M10 11v6 M14 11v6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7V4a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="#ef4444" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                             </Canvas>
                                         </Viewbox>
                                        <TextBlock Text="{DynamicResource String.ClearLogs}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </StackPanel>

            <!-- Tracking Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M10 14a3.5 3.5 0 0 0 5 0l4 -4a3.5 3.5 0 0 0 -5 -5l-.5 .5 M14 10a3.5 3.5 0 0 0 -5 0l-4 4a3.5 3.5 0 0 0 5 5l.5 -.5" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Tracking" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                
                <StackPanel Spacing="6">
                    <!-- MyAnimeList Connection -->
                    <Border Background="{DynamicResource SidebarBackground}" Padding="20,15" CornerRadius="8" BoxShadow="0 2 10 0 #05000000">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="MyAnimeList" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" FontSize="16"/>
                                    <!-- Status Badge -->
                                    <Panel VerticalAlignment="Center">
                                        <Border Background="#2000C853" CornerRadius="8" Padding="8,2" IsVisible="{Binding IsMalConnected}">
                                            <TextBlock Text="CONNECTED" Foreground="#00C853" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#20888888" CornerRadius="8" Padding="8,2" IsVisible="{Binding !IsMalConnected}">
                                            <TextBlock Text="DISCONNECTED" Foreground="{DynamicResource SecondaryText}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </StackPanel>
                                <TextBlock Text="Sync your reading progress automatically to your MyAnimeList account." FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            
                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                <Button Command="{Binding ConnectMalCommand}" Content="Connect" 
                                        Background="{DynamicResource PrimaryAccent}" Foreground="#FFFFFF"
                                        CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                        Cursor="Hand" IsVisible="{Binding !IsMalConnected}"/>
                                <Button Command="{Binding DisconnectMalCommand}" Content="Disconnect" 
                                        Background="#15ef4444" BorderBrush="Transparent" BorderThickness="0" 
                                        Foreground="#ef4444" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                        Cursor="Hand" IsVisible="{Binding IsMalConnected}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#ef4444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Panel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Danger Zone Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                      <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M12 9v4 M12 17h.01 M5 19h14a2 2 0 0 0 1.84 -2.75l-7.1 -12.25a2 2 0 0 0 -3.5 0l-7.1 12.25a2 2 0 0 0 1.75 2.75" Stroke="#FF5555" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                     <TextBlock Text="{DynamicResource String.DangerZone}" FontSize="18" FontWeight="SemiBold" Foreground="#FF5555"/>
                </StackPanel>
                <Border BorderBrush="#40FF5555" BorderThickness="1" CornerRadius="8" Background="#05FF5555">
                    <StackPanel Spacing="0">
                        <!-- Clear Read History -->
                        <Grid ColumnDefinitions="*, Auto" Margin="20,15">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.ClearHistoryCache}" FontWeight="SemiBold" Foreground="#F59E0B" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.ClearHistoryCacheDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String.ClearAll}" Command="{Binding ClearReadHistoryCommand}" 
                                    Background="#15F59E0B" BorderBrush="Transparent" BorderThickness="0" 
                                    Foreground="#F59E0B" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#F59E0B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                        
                        <Border Height="1" Background="#20FF5555" Margin="20,0"/>

                        <!-- Clear Non-Library Cache -->
                        <Grid ColumnDefinitions="*, Auto" Margin="20,15">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.ClearNonLibrary}" FontWeight="SemiBold" Foreground="#F59E0B" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.ClearNonLibraryDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String.CleanDatabase}" Command="{Binding ClearNonLibraryCommand}" 
                                    Background="#15F59E0B" BorderBrush="Transparent" BorderThickness="0" 
                                    Foreground="#F59E0B" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#F59E0B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                        
                        <Border Height="1" Background="#20FF5555" Margin="20,0"/>
                        
                        <!-- Clear All Data -->
                        <Grid ColumnDefinitions="*, Auto" Margin="20,15">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource String.ClearAllData}" FontWeight="SemiBold" Foreground="#FF5555" FontSize="16"/>
                                <TextBlock Text="{DynamicResource String.ClearAllDataDesc}" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource String.ResetData}" Command="{Binding ClearAllDataCommand}" 
                                    Background="#15FF5555" BorderBrush="Transparent" BorderThickness="0" 
                                    Foreground="#FF5555" CornerRadius="8" Padding="20,8" FontWeight="SemiBold" FontSize="13"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#FF5555"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                     <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                         <Canvas Width="24" Height="24">
                             <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M12 9h.01 M11 12h1v4h1" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                         </Canvas>
                     </Viewbox>
                     <TextBlock Text="{DynamicResource String.About}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
                <Border Background="{DynamicResource SidebarBackground}" CornerRadius="16" Padding="40" BoxShadow="0 4 15 0 #20000000">
                    <Grid ColumnDefinitions="Auto, *" Margin="10">
                        <!-- Logo Column -->
                        <Border Grid.Column="0" Width="80" Height="80" VerticalAlignment="Top" CornerRadius="20" ClipToBounds="True" Background="Transparent" BoxShadow="0 4 10 0 #30000000">
                            <Image Source="/Assets/app.ico" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>

                        <!-- Content Column -->
                        <StackPanel Grid.Column="1" Margin="30,0,0,0" Spacing="15">
                            <!-- App Name & Version -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="Yomic" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" LineHeight="40"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Background="#20FFFFFF" CornerRadius="6" Padding="8,2">
                                        <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="by ArisaAkiyama" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}" FontSize="13" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Foreground="{DynamicResource PrimaryText}" FontSize="14" LineHeight="24" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" TextAlignment="Left">
                                <Run Text="{DynamicResource String.AboutDesc1}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource String.AboutDesc2}"/>
                            </TextBlock>

                            <!-- Actions Row -->
                            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,5,0,0">
                                <Button Command="{Binding VisitWebsiteCommand}" Content="{DynamicResource String.VisitWebsite}" 
                                        FontWeight="SemiBold" FontSize="13"
                                        CornerRadius="16" Padding="18,8" Cursor="Hand">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                        </Style>
                                    </Button.Styles>
                                </Button>



                                <Button Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsUpdateActionEnabled}"
                                        Classes.available="{Binding IsUpdateAvailableStyle}"
                                        CornerRadius="16" Padding="18,8" Cursor="Hand">
                                    <Button.Styles>
                                        <!-- Normal State (Idle) -->
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                        </Style>

                                        <!-- Update Available State -->
                                        <Style Selector="Button.available">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryAccent}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="Button.available:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#005A9E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>

                                        <!-- Downloading/Installing State (Disabled) -->
                                        <Style Selector="Button:disabled">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style Selector="Button:disabled /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="M 12 2 A 10 10 0 1 1 2 12" Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2.5" 
                                              Width="16" Height="16" Stretch="Uniform" RenderTransformOrigin="50%,50%"
                                              IsVisible="{Binding IsDownloadingUpdate}" VerticalAlignment="Center">
                                            <Path.Styles>
                                                <Style Selector="Path">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:0.8" IterationCount="Infinite">
                                                            <KeyFrame KeyTime="0:0:0">
                                                                <Setter Property="RotateTransform.Angle" Value="0"/>
                                                            </KeyFrame>
                                                            <KeyFrame KeyTime="0:0:0.8">
                                                                <Setter Property="RotateTransform.Angle" Value="360"/>
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </Path.Styles>
                                        </Path>
                                        <TextBlock Text="{Binding UpdateStatusText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenTrakteerCommand}" 
                                        ToolTip.Tip="Dukung Saya di Trakteer"
                                        Height="40" CornerRadius="20" Padding="18,0" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="#BE1E2D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#D62435"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M18.5 4h-13A2.5 2.5 0 0 0 3 6.5v6A5.5 5.5 0 0 0 8.5 18h4a5.5 5.5 0 0 0 5.4-4.5H19a3 3 0 0 0 3-3v-3.5A3 3 0 0 0 19 4h-.5zm.5 6.5A1 1 0 0 1 18 11.5h-.08A5.5 5.5 0 0 0 18 10V6h1a1 1 0 0 1 1 1v3.5zM5 6.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v6a3.5 3.5 0 0 1-3.5 3.5h-4A3.5 3.5 0 0 1 5 12.5v-6zM3 20h18v1.5a.5.5 0 0 1-.5.5h-17a.5.5 0 0 1-.5-.5V20z" Fill="White"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Dukung Saya di Trakteer" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Social Icons -->
                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
                                <!-- GitHub -->
                                <Button Command="{Binding OpenGitHubCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip.Tip="GitHub" Padding="5">
                                    <Button.Styles>
                                        <Style Selector="PathIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <Style Selector="Button:pointerover PathIcon">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </Button.Styles>
