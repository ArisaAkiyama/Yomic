<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Yomic.ViewModels"
             xmlns:helpers="clr-namespace:Yomic.Views.Helpers"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Yomic.Views.SourceFeedView"
             x:DataType="vm:SourceFeedViewModel"
             Background="{DynamicResource PrimaryBackground}">
             
     <UserControl.Styles>
         <Style Selector="Button.BackBtn">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
             <Setter Property="Padding" Value="10"/>
             <Setter Property="CornerRadius" Value="20"/>
             <Setter Property="Transitions">
                 <Transitions>
                     <BrushTransition Property="Background" Duration="0:0:0.2"/>
                     <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                     <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                 </Transitions>
             </Setter>
         </Style>
         <Style Selector="Button.BackBtn:pointerover /template/ ContentPresenter">
             <Setter Property="Background" Value="#0078D7"/>
             <Setter Property="Foreground" Value="#1E1E2E"/>
         </Style>
         <Style Selector="Button.BackBtn:pointerover">
             <Setter Property="RenderTransform" Value="scale(1.05)"/>
         </Style>
         
         <!-- Card Style same as Library -->
         <Style Selector="Border.MangaCard">
             <Setter Property="ZIndex" Value="1"/>
             <Setter Property="Transitions">
                 <Transitions>
                     <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                 </Transitions>
             </Setter>
         </Style>
         <Style Selector="Border.MangaCard:pointerover">
             <Setter Property="ZIndex" Value="10"/>
             <Setter Property="BoxShadow" Value="0 10 20 0 #60000000"/>
             <Setter Property="Cursor" Value="Hand"/>
         </Style>

         <Style Selector="Border.MangaCard Image">
             <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
             <Setter Property="Transitions">
                 <Transitions>
                     <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                 </Transitions>
             </Setter>
         </Style>
         <Style Selector="Border.MangaCard:pointerover Image">
             <Setter Property="RenderTransform" Value="scale(1.08)"/>
         </Style>
         
         <!-- Pagination Button Style -->
         <Style Selector="Button.PageBtn">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
             <Setter Property="CornerRadius" Value="15"/>
             <Setter Property="Padding" Value="15,6"/>
             <Setter Property="Transitions">
                 <Transitions>
                     <BrushTransition Property="Background" Duration="0:0:0.2"/>
                 </Transitions>
             </Setter>
         </Style>
          <Style Selector="Button.PageBtn:pointerover /template/ ContentPresenter">
             <Setter Property="Background" Value="#15FFFFFF"/>
             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
         </Style>
         <Style Selector="Button.PageBtn:disabled /template/ ContentPresenter">
             <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
         </Style>

         <!-- Standard Header Action Button Style -->
         <Style Selector="Button.header-action">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="BorderThickness" Value="0"/>
             <Setter Property="Padding" Value="12,8"/>
             <Setter Property="CornerRadius" Value="8"/>
             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
         </Style>
         <Style Selector="Button.header-action:pointerover /template/ ContentPresenter">
             <Setter Property="Background" Value="#15FFFFFF"/>
         </Style>
         <Style Selector="Button.header-action:pointerover">
             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
         </Style>
         <Style Selector="Button.header-action:pressed /template/ ContentPresenter">
             <Setter Property="Background" Value="#25FFFFFF"/>
         </Style>

         <!-- Disable transitions for header buttons to avoid color "lag" -->
         <Style Selector="Button.header-action TextBlock">
              <Setter Property="Transitions" Value="{x:Null}"/>
         </Style>

         <Style Selector="Button.header-action.accent">
             <Setter Property="Foreground" Value="#FFFFFF"/>
         </Style>
         <Style Selector="Button.header-action.accent:pointerover">
             <Setter Property="Foreground" Value="#FFFFFF"/>
         </Style>


     </UserControl.Styles>

     <Grid RowDefinitions="Auto, *, Auto">
          <!-- Header / Search Bar (Aligned with LibraryView) -->
          <StackPanel Grid.Row="0" Margin="30,25,30,15">
                  <!-- Title Row -->
                 <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
                      <Button Command="{Binding BackCommand}" HotKey="Escape" Classes="BackBtn">
                          <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                              <Canvas Width="24" Height="24">
                                  <Path Data="M5 12l14 0 M5 12l6 6 M5 12l6 -6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                              </Canvas>
                          </Viewbox>
                      </Button>
                     <StackPanel Orientation="Horizontal" Spacing="10">
                         <TextBlock Text="{DynamicResource String.BrowseSource}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                         <TextBlock Text="—" FontSize="18" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Opacity="0.5"/>
                         <Border Width="28" Height="28" CornerRadius="8" Background="{Binding IconColor}" ClipToBounds="True" VerticalAlignment="Center">
                              <Panel>
                                  <TextBlock Text="{Binding IconText}" Foreground="{Binding IconForeground}" FontWeight="ExtraBold" FontSize="16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding IconText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                  <Image Source="{Binding IconBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality"
                                         IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                              </Panel>
                         </Border>
                         <TextBlock Text="{Binding SourceName}" FontSize="24" FontWeight="Bold" Foreground="#0078D7" VerticalAlignment="Center"/>
                     </StackPanel>
                 </StackPanel>

                  <!-- Search & Filter Row (Similar to Library) -->
                 <Grid>
                     <!-- Actual Search Box & Buttons -->
                     <Grid ColumnDefinitions="*, Auto, Auto" IsVisible="{Binding !IsBusy}">
                         <!-- Modern Enhanced Search Bar (Library Style) -->
                          <TextBox Grid.Column="0" HorizontalAlignment="Stretch"
                                   x:Name="SearchBox"
                                   Watermark="{DynamicResource String.SearchManga}" CornerRadius="20"
                                   Text="{Binding SearchText}"
                                   Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0"
                                   Padding="8,8,15,8" VerticalContentAlignment="Center" FontSize="13">
                             <TextBox.KeyBindings>
                                 <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                             </TextBox.KeyBindings>
                             <TextBox.Styles>
                                 <!-- Match Library View Focus Styles -->
                                 <Style Selector="TextBox:focus">
                                     <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                     <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
                                 </Style>
                                 <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                     <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                     <Setter Property="BorderThickness" Value="0"/>
                                 </Style>
                                 <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                     <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                     <Setter Property="BorderThickness" Value="0"/>
                                 </Style>
                                  <Style Selector="TextBox:pointerover">
                                      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                  </Style>
                                  
                                  <!-- Watermark -->
                                  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
                                      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                  </Style>
                                  <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark">
                                      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                  </Style>
                                  <Style Selector="TextBox:pointerover /template/ TextBlock#PART_Watermark">
                                      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                  </Style>
                             </TextBox.Styles>
                             
                             <TextBox.InnerLeftContent>
                                 <Button Command="{Binding SearchCommand}" 
                                         Background="Transparent" BorderThickness="0" 
                                         Padding="0" Margin="12,0,0,0" Cursor="Hand">
                                     <Button.Styles>
                                         <Style Selector="Button:pointerover /template/ ContentPresenter">
                                             <Setter Property="Background" Value="Transparent"/>
                                         </Style>
                                         <Style Selector="Button:pressed /template/ ContentPresenter">
                                             <Setter Property="Background" Value="Transparent"/>
                                         </Style>
                                         <Style Selector="Button:pressed TextBlock">
                                             <Setter Property="Opacity" Value="0.7"/>
                                         </Style>
                                     </Button.Styles>
                                      <Viewbox Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                          <Canvas Width="24" Height="24">
                                              <Path Data="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                          </Canvas>
                                      </Viewbox>
                                 </Button>
                             </TextBox.InnerLeftContent>
                         </TextBox>
                         
                         <!-- Buttons -->
                         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                             <!-- List View Toggle -->
                             <Button Command="{Binding ToggleViewModeCommand}" 
                                     Classes="header-action"
                                     ToolTip.Tip="Toggle View Mode (Grid/List)">
                                     <Panel>
                                          <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsListView}">
                                              <Canvas Width="24" Height="24">
                                                  <Path Data="M9 6l11 0 M9 12l11 0 M9 18l11 0 M5 6l0 .01 M5 12l0 .01 M5 18l0 .01" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                              </Canvas>
                                          </Viewbox>
                                          <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsListView}">
                                              <Canvas Width="24" Height="24">
                                                  <Path Data="M4 4h6v6h-6z M14 4h6v6h-6z M4 14h6v6h-6z M14 14h6v6h-6z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                              </Canvas>
                                          </Viewbox>
                                     </Panel>
                             </Button>

                             <!-- Refresh Button -->
                             <Button Command="{Binding RefreshCommand}" 
                                     Classes="header-action"
                                     ToolTip.Tip="Refresh (Bypass Cache)">
                                      <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                          <Canvas Width="24" Height="24">
                                              <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -5v5h5 M4 13a8.1 8.1 0 0 0 15.5 2m.5 5v-5h-5" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                          </Canvas>
                                      </Viewbox>
                             </Button>

                             <!-- Language Toggle (Flag Only) - MangaDex Only -->
                             <Button Command="{Binding ToggleLanguageCommand}" 
                                     IsVisible="{Binding IsMangaDex}"
                                     Background="Transparent" Padding="4"
                                     CornerRadius="4"
                                     ToolTip.Tip="Toggle Language: English / Indonesian">
                                 <Button.Styles>
                                     <Style Selector="Button:pointerover /template/ ContentPresenter">
                                         <Setter Property="Background" Value="#15FFFFFF"/>
                                     </Style>
                                 </Button.Styles>
                                 <Image Source="{Binding LanguageFlagBitmap}" Width="24" Height="16" Stretch="Uniform"/>
                             </Button>

                             <!-- Unified Filter Button -->
                             <Button Classes="header-action"
                                     Classes.accent="{Binding IsAnyFilterActive}"
                                     IsVisible="{Binding !IsLatestMode}"
                                     ToolTip.Tip="Filter options">
                                 <Button.Flyout>
                                     <MenuFlyout Placement="BottomEdgeAlignedRight">
                                         <!-- Filter by Status -->
                                         <MenuItem Header="Filter by Status" IsVisible="{Binding IsStatusFilterVisible}">
                                             <MenuItem.Icon>
                                                  <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                      <Canvas Width="24" Height="24">
                                                          <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                      </Canvas>
                                                  </Viewbox>
                                             </MenuItem.Icon>
                                             <MenuItem Header="All Statuses" Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:SourceStatusFilterMode.All}">
                                                 <MenuItem.Icon>
                                                      <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsStatusAllSelected}">
                                                          <Canvas Width="24" Height="24">
                                                              <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                          </Canvas>
                                                      </Viewbox>
                                                 </MenuItem.Icon>
                                             </MenuItem>
                                             <MenuItem Header="Ongoing" Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:SourceStatusFilterMode.Ongoing}">
                                                 <MenuItem.Icon>
                                                      <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsStatusOngoingSelected}">
                                                          <Canvas Width="24" Height="24">
                                                              <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                          </Canvas>
                                                      </Viewbox>
                                                 </MenuItem.Icon>
                                             </MenuItem>
                                             <MenuItem Header="Completed" Command="{Binding SetStatusFilterCommand}" CommandParameter="{x:Static vm:SourceStatusFilterMode.Completed}">
                                                 <MenuItem.Icon>
                                                      <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsStatusCompletedSelected}">
                                                          <Canvas Width="24" Height="24">
                                                              <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                          </Canvas>
                                                      </Viewbox>
                                                 </MenuItem.Icon>
                                             </MenuItem>
                                         </MenuItem>

                                         <!-- Filter by Genre -->
                                         <MenuItem Header="Filter by Genre" StaysOpenOnClick="True" IsVisible="{Binding IsGenreFilterVisible}">
                                             <MenuItem.Icon>
                                                  <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                      <Canvas Width="24" Height="24">
                                                          <Path Data="M7.5 7.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M3 6a3 3 0 0 1 3 -3h4a3 3 0 0 1 2.12 .88l8 8a3 3 0 0 1 0 4.24l-4 4a3 3 0 0 1 -4.24 0l-8 -8A3 3 0 0 1 3 10V6z" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                      </Canvas>
                                                  </Viewbox>
                                             </MenuItem.Icon>
                                             <MenuItem.Styles>
                                                 <Style Selector="MenuItem > MenuItem">
                                                     <Setter Property="Template">
                                                         <ControlTemplate>
                                                             <ContentPresenter Content="{TemplateBinding Header}"
                                                                               ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                                         </ControlTemplate>
                                                     </Setter>
                                                 </Style>
                                             </MenuItem.Styles>
                                             <Grid RowDefinitions="Auto, *" Width="180" Margin="12,8,12,8">
                                                 <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                                     <TextBlock Text="Filter by Genre" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                                                     <Button Grid.Column="1" Content="Clear" 
                                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentColor}"
                                                             Command="{Binding ClearGenreFilterCommand}" 
                                                             Padding="4,2" FontSize="12"/>
                                                 </Grid>
                                                 
                                                 <ScrollViewer Grid.Row="1" MaxHeight="250" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                     <ItemsControl ItemsSource="{Binding AvailableGenres}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate DataType="vm:SourceFeedViewModel+GenreFilterItem" x:CompileBindings="False">
                                                                 <CheckBox Content="{Binding Name}" 
                                                                           IsChecked="{Binding IsSelected}" 
                                                                           Margin="0"
                                                                           Padding="8,0,0,0" MinHeight="28"
                                                                           HorizontalAlignment="Stretch"/>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </ScrollViewer>
                                             </Grid>
                                         </MenuItem>

                                         <!-- Filter by Format -->
                                         <MenuItem Header="Filter by Format" StaysOpenOnClick="True" IsVisible="{Binding IsFormatFilterVisible}">
                                             <MenuItem.Icon>
                                                  <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                      <Canvas Width="24" Height="24">
                                                          <Path Data="M4 4h6v6h-6z M14 4h6v6h-6z M4 14h6v6h-6z M17 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                      </Canvas>
                                                  </Viewbox>
                                             </MenuItem.Icon>
                                             <MenuItem.Styles>
                                                 <Style Selector="MenuItem > MenuItem">
                                                     <Setter Property="Template">
                                                         <ControlTemplate>
                                                             <ContentPresenter Content="{TemplateBinding Header}"
                                                                               ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                                         </ControlTemplate>
                                                     </Setter>
                                                 </Style>
                                             </MenuItem.Styles>
                                             <Grid RowDefinitions="Auto, *" Width="180" Margin="12,8,12,8">
                                                 <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                                                     <TextBlock Text="Filter by Format" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                                                     <Button Grid.Column="1" Content="Clear" 
                                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentColor}"
                                                             Command="{Binding ClearFormatFilterCommand}" 
                                                             Padding="4,2" FontSize="12"/>
                                                 </Grid>
                                                 
                                                 <ScrollViewer Grid.Row="1" MaxHeight="250" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                     <ItemsControl ItemsSource="{Binding AvailableFormats}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate DataType="vm:SourceFeedViewModel+FormatFilterItem" x:CompileBindings="False">
                                                                 <CheckBox Content="{Binding Name}" 
                                                                           IsChecked="{Binding IsSelected}" 
                                                                           Margin="0"
                                                                           Padding="8,0,0,0" MinHeight="28"
                                                                           HorizontalAlignment="Stretch"/>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </ScrollViewer>
                                             </Grid>
                                         </MenuItem>
                                     </MenuFlyout>
                                 </Button.Flyout>
                                 <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                      <Canvas Width="24" Height="24">
                                          <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                      </Canvas>
                                  </Viewbox>
                             </Button>

                             <!-- Latest Updates Toggle -->
                             <Button Command="{Binding LatestModeCommand}" 
                                     Classes="header-action"
                                     Classes.accent="{Binding IsLatestMode}"
                                     ToolTip.Tip="Toggle Latest Updates">
                                  <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                      <Canvas Width="24" Height="24">
                                          <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M12 7v5l3 3" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                      </Canvas>
                                  </Viewbox>
                             </Button>
                         </StackPanel>
                     </Grid>
                     
                     <!-- Skeletons (Visible when busy) -->
                     <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsBusy}">
                         <Border Grid.Column="0" Classes="SkeletonCard" Height="36" CornerRadius="18" HorizontalAlignment="Stretch"/>
                         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                             <!-- List View Toggle skeleton -->
                             <Border Classes="SkeletonCard" Width="38" Height="36" CornerRadius="8"/>
                             <!-- Refresh Button skeleton -->
                             <Border Classes="SkeletonCard" Width="38" Height="36" CornerRadius="8"/>
                             <!-- Language Toggle skeleton -->
                             <Border Classes="SkeletonCard" Width="32" Height="24" CornerRadius="4" VerticalAlignment="Center" IsVisible="{Binding IsMangaDex}"/>
                             <!-- Filter Button skeleton -->
                             <Border Classes="SkeletonCard" Width="70" Height="36" CornerRadius="8"/>
                             <!-- Latest Updates skeleton -->
                             <Border Classes="SkeletonCard" Width="75" Height="36" CornerRadius="8"/>
                         </StackPanel>
                     </Grid>
                 </Grid>
             </StackPanel>

         <!-- Content -->
         <Panel Grid.Row="1" IsVisible="{Binding !IsBusy}">

             <!-- content wrapper -->
              <!-- Removed ScrollViewer to allow virtualized ListBox to handle scrolling -->
              <Grid>
                  <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/> <!-- Error Message -->
                      <RowDefinition Height="*"/>    <!-- List -->
                      <RowDefinition Height="Auto"/> <!-- Footer -->
                  </Grid.RowDefinitions>
                  
                  <!-- BLOCKED STATE UI (MangaDex) -->
                  <Border Grid.Row="1" Background="#1E1E2E" IsVisible="{Binding IsMangaDexBlocked}" ZIndex="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                           <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                               <Canvas Width="24" Height="24">
                                   <Path Data="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3 M10 10l4 4 M14 10l-4 4" Stroke="#F38BA8" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                               </Canvas>
                           </Viewbox>
                          <TextBlock Text="MangaDex is Blocked" FontSize="24" FontWeight="Bold" Foreground="#F38BA8" HorizontalAlignment="Center"/>
                          <TextBlock Text="It seems your network is blocking access to MangaDex." Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                          
                          <Border Background="#313244" CornerRadius="8" Padding="20" MaxWidth="400">
                              <StackPanel Spacing="10">
                                  <TextBlock Text="Recommended Solutions:" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                      <TextBlock Text="1." Foreground="{DynamicResource SecondaryText}"/>
                                      <TextBlock Text="Enable VPN (Cloudflare WARP or similar)" Foreground="{DynamicResource PrimaryText}"/>
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" Spacing="10">
                                      <TextBlock Text="2." Foreground="{DynamicResource SecondaryText}"/>
                                      <TextBlock Text="Change DNS to 1.1.1.1 or 8.8.8.8" Foreground="{DynamicResource PrimaryText}"/>
                                  </StackPanel>
                              </StackPanel>
                          </Border>
                          
                          <Button Command="{Binding RefreshCommand}" 
                                  Content="Try Again"
                                  HorizontalAlignment="Center"
                                  Classes="PageBtn"
                                  Background="#0078D7" Foreground="#FFFFFF"/>
                      </StackPanel>
                  </Border>

                  <!-- Empty State (No Results / Bad Connection) -->
                  <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                      <StackPanel.IsVisible>
                         <MultiBinding Converter="{x:Static BoolConverters.And}">
                             <Binding Path="IsSourceEmpty"/>
                             <Binding Path="!IsLoading"/>
                             <Binding Path="!IsBusy"/>
                         </MultiBinding>
                      </StackPanel.IsVisible>

                      <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                          <Canvas Width="24" Height="24">
                              <Path Data="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" Stroke="#45475A" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                          </Canvas>
                      </Viewbox>
                     <TextBlock Text="Manga Not Found" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                     <TextBlock Text="It seems the network connection is poor or blocked (Cloudflare/Error). Please refresh." FontSize="16" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                  </StackPanel>

                  <!-- Virtualized Items List -->
                  <!-- Use ListBox for virtualization support -->
                  <ListBox x:Name="MangaListBox" Grid.Row="1" ItemsSource="{Binding MangaList}" Background="Transparent" 
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Visible"
                           ScrollViewer.AllowAutoHide="False"
                           Padding="0,0,0,20"
                           IsVisible="{Binding !IsListView}">
                       <ListBox.ItemsPanel>
                           <ItemsPanelTemplate>
                               <WrapPanel Orientation="Horizontal" ItemWidth="175" ItemHeight="310" HorizontalAlignment="Center"/>
                           </ItemsPanelTemplate>
                       </ListBox.ItemsPanel>
                      
                      <ListBox.Styles>
                          <Style Selector="ListBoxItem">
                              <Setter Property="Padding" Value="0"/>
                              <Setter Property="Margin" Value="0"/>
                              <Setter Property="Background" Value="Transparent"/>
                          </Style>
                          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                              <Setter Property="Background" Value="Transparent"/>
                          </Style>
                          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                              <Setter Property="Background" Value="Transparent"/>
                          </Style>
                      </ListBox.Styles>

                      <ListBox.ItemTemplate>
                          <DataTemplate>
                               <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="10,0,10,20"
                                       Command="{Binding DataContext.OpenMangaCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                       CommandParameter="{Binding}">
                                   <Button.Styles>
                                      <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                          <Setter Property="Background" Value="Transparent"/>
                                          <Setter Property="Opacity" Value="1.0"/>
                                      </Style>
                                   </Button.Styles>
                                   <StackPanel Width="150" Spacing="10">
                                       <!-- Cover Image -->
                                       <Border Classes="MangaCard" Height="225" CornerRadius="12" 
                                               Background="{DynamicResource SidebarBackground}" ClipToBounds="True"
                                               BoxShadow="0 4 10 0 #40000000">
                                           <Grid>
                                               <Image helpers:SecureImageLoader.Url="{Binding CoverUrl}" 
                                                      helpers:SecureImageLoader.DecodeWidth="300"
                                                      Stretch="UniformToFill"/>
                                               
                                                <!-- Status Ribbon (Top-Left) -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                        Width="100" Height="18" Margin="-32,9,0,0"
                                                        Background="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.Instance}}"
                                                        IsVisible="{Binding Status, Converter={x:Static vm:StatusToColorConverter.StatusToVisibility}}">
                                                    <Border.RenderTransform>
                                                        <RotateTransform Angle="-45"/>
                                                    </Border.RenderTransform>
                                                    <TextBlock Text="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.ToUpperConverter}}" 
                                                               FontSize="8" FontWeight="900" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Border>

                                               <!-- Time Overlay (Bottom) -->
                                               <Panel VerticalAlignment="Bottom" IsVisible="{Binding LastUpdateString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                   <!-- Gradient Shadow for readability -->
                                                   <Border Height="60" VerticalAlignment="Bottom">
                                                       <Border.Background>
                                                           <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                               <GradientStop Offset="0" Color="#00000000"/>
                                                               <GradientStop Offset="1" Color="#D0000000"/>
                                                           </LinearGradientBrush>
                                                       </Border.Background>
                                                   </Border>
                                                   
                                                   <!-- Text -->
                                                   <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0,10,10" VerticalAlignment="Bottom">
                                                       <Viewbox Width="10" Height="10" VerticalAlignment="Center">
                                                           <Canvas Width="24" Height="24">
                                                               <Path Data="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12 M16 3v4 M8 3v4 M4 11h16 M11 15h1 M12 15v3" Stroke="#0078D7" StrokeThickness="3.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                           </Canvas>
                                                       </Viewbox>
                                                       <TextBlock Text="{Binding LastUpdateString}" Foreground="#0078D7" 
                                                                  FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                   </StackPanel>
                                               </Panel>
                                           </Grid>
                                       </Border>
                                       
                                       <!-- Title Below Image -->
                                       <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" 
                                                  TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                                  FontSize="14" FontWeight="Medium" MaxLines="2"/>
                                   </StackPanel>
                               </Button>
                          </DataTemplate>
                      </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- Virtualized List View ListBox -->
                  <ListBox x:Name="MangaListModeBox" Grid.Row="1" ItemsSource="{Binding MangaList}" Background="Transparent" 
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           IsVisible="{Binding IsListView}">
                       <ListBox.Styles>
                           <Style Selector="ListBoxItem">
                               <Setter Property="Padding" Value="0"/>
                               <Setter Property="Margin" Value="0"/>
                               <Setter Property="Background" Value="Transparent"/>
                           </Style>
                           <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                               <Setter Property="Background" Value="Transparent"/>
                           </Style>
                           <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                               <Setter Property="Background" Value="Transparent"/>
                           </Style>
                       </ListBox.Styles>

                       <ListBox.ItemsPanel>
                           <ItemsPanelTemplate>
                               <VirtualizingStackPanel Orientation="Vertical" Margin="30,0,30,0"/> 
                           </ItemsPanelTemplate>
                       </ListBox.ItemsPanel>

                       <ListBox.ItemTemplate>
                           <DataTemplate>
                                <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="0,0,0,4"
                                        Command="{Binding DataContext.OpenMangaCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Button.Styles>
                                       <Style Selector="Button:pointerover /template/ ContentPresenter">
                                           <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                       </Style>
                                    </Button.Styles>
                                    
                                    <Border CornerRadius="8" Padding="8" Background="Transparent">
                                       <Grid ColumnDefinitions="60, 16, *, Auto">
                                           <Border Grid.Column="0" Height="80" Width="60" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SidebarBackground}">
                                               <Image helpers:SecureImageLoader.Url="{Binding CoverUrl}" 
                                                      helpers:SecureImageLoader.DecodeWidth="300"
                                                      Stretch="UniformToFill"/>
                                           </Border>
                                           
                                           <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                               <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" 
                                                          TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                                          FontSize="14" FontWeight="SemiBold" MaxLines="1"/>
                                               <StackPanel Orientation="Horizontal" Spacing="6">
                                                   <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryText}" 
                                                              FontSize="12" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                              IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                   <TextBlock Text="·" Foreground="{DynamicResource SecondaryText}" FontSize="12" Opacity="0.5"
                                                              IsVisible="{Binding LastUpdateString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                   <TextBlock Text="{Binding LastUpdateString}" Foreground="#0078D7" 
                                                              FontSize="12" FontWeight="SemiBold" MaxLines="1"
                                                              IsVisible="{Binding LastUpdateString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                               </StackPanel>
                                           </StackPanel>

                                           <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                               <Border Background="#89B4FA" CornerRadius="4" Padding="6,2"
                                                       IsVisible="{Binding IsNewBadgeVisible}">
                                                   <TextBlock Text="NEW" Foreground="#1E1E2E" FontSize="10" FontWeight="Bold"/>
                                               </Border>
                                               <!-- Status Ribbon (Top-Left) -->
                                               <Border HorizontalAlignment="Right"
                                                       Padding="6,2" CornerRadius="4"
                                                       Background="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.Instance}}"
                                                       IsVisible="{Binding Status, Converter={x:Static vm:StatusToColorConverter.StatusToVisibility}}">
                                                   <TextBlock Text="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.ToUpperConverter}}" 
                                                              FontSize="10" FontWeight="Bold" Foreground="White"/>
                                               </Border>
                                           </StackPanel>
                                       </Grid>
                                    </Border>
                                </Button>
                           </DataTemplate>
                       </ListBox.ItemTemplate>
                  </ListBox>
                     
                    <!-- Pagination Controls (Footer) -->
                    <!-- Modern Pill Pagination -->
                    <Border Grid.Row="2" IsVisible="{Binding IsPaginationVisible}"
                            HorizontalAlignment="Center" Margin="0,15,0,25"
                            Background="{DynamicResource SidebarBackground}"
                            CornerRadius="25"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="2"
                            BoxShadow="0 4 15 0 #30000000">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- Prev Button -->
                            <Button Command="{Binding PrevPageCommand}" 
                                    Classes="PageBtn"
                                    IsEnabled="{Binding HasPrevPage}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                     <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                          <Canvas Width="24" Height="24">
                                              <Path Data="M15 6l-6 6l6 6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                          </Canvas>
                                      </Viewbox>
                                      <TextBlock Text="{DynamicResource String.Previous}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
    
                            <!-- Page Info Button with Flyout -->
                            <Button Content="{Binding PageInfo}" 
                                    Classes="PageBtn"
                                    Foreground="{DynamicResource PrimaryAccent}" 
                                    FontWeight="Bold" 
                                    FontSize="14"
                                    Cursor="Hand"
                                    ToolTip.Tip="{DynamicResource String.JumpToPageTooltip}">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
                                    </Style>
                                </Button.Styles>
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <Border Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" BoxShadow="0 10 30 0 #80000000">
                                            <StackPanel Spacing="16">
                                                <TextBlock Text="{DynamicResource String.JumpToPage}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                                
                                                <TextBox Width="180" 
                                                         Text="{Binding TargetPageInput}" 
                                                         Watermark="{DynamicResource String.EnterPageWatermark}"
                                                         CornerRadius="8"
                                                         Padding="10,6"
                                                         Background="{DynamicResource PrimaryBackground}"
                                                         Foreground="{DynamicResource PrimaryText}"
                                                         BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding GoToPageCommand}"/>
                                                    </TextBox.KeyBindings>
                                                    <TextBox.InnerRightContent>
                                                        <Button Command="{Binding GoToPageCommand}"
                                                                Background="{DynamicResource PrimaryAccent}" 
                                                                Foreground="White" 
                                                                FontWeight="Bold" 
                                                                CornerRadius="6" 
                                                                Padding="12,4"
                                                                Margin="2">
                                                            <Button.Styles>
                                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                    <Setter Property="Background" Value="#3395FF"/>
                                                                </Style>
                                                            </Button.Styles>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{DynamicResource String.Go}" VerticalAlignment="Center"/>
                                                                <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                                    <Canvas Width="24" Height="24">
                                                                        <Path Data="M9 6l6 6l-6 6" Stroke="White" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                                    </Canvas>
                                                                </Viewbox>
                                                            </StackPanel>
                                                        </Button>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
    
                            <!-- Next Button -->
                            <Button Command="{Binding NextPageCommand}" 
                                    Classes="PageBtn"
                                    IsEnabled="{Binding HasNextPage}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{DynamicResource String.Next}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                     <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                         <Canvas Width="24" Height="24">
                                             <Path Data="M9 6l6 6l-6 6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                         </Canvas>
                                     </Viewbox>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                     </Border>
                 </Grid>
             <!-- </StackPanel> -->
             <!-- </ScrollViewer> -->
        </Panel>

        <!-- Skeleton Loading (aligned 100% with manga grid) -->
        <Border Grid.Row="1" IsVisible="{Binding IsBusy}">
            <WrapPanel Orientation="Horizontal" ItemWidth="175" ItemHeight="310" HorizontalAlignment="Center">
                <!-- 1 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 2 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="100" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 3 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="130" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 4 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 5 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="140" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 6 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="125" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 7 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="95" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 8 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="135" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 9 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="115" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 10 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="105" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 11 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 12 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="130" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 13 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="110" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
                <!-- 14 -->
                <Button Background="Transparent" Padding="0" Margin="10,0,10,20" IsHitTestVisible="False">
                    <StackPanel Width="150" Spacing="8">
                        <Border Classes="SkeletonCard" Height="225" CornerRadius="12"/>
                        <Border Classes="SkeletonText" Width="120" Height="14" CornerRadius="4"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
     </Grid>
 </UserControl>
