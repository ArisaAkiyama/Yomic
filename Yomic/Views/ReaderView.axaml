<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yomic.ViewModels"
             x:Class="Yomic.Views.ReaderView"
             x:DataType="vm:ReaderViewModel"
             Background="{DynamicResource PrimaryBackground}"
             Focusable="True">
    
    <UserControl.Styles>
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style Selector="TextBlock.Active">
             <Setter Property="Foreground" Value="#0078D7"/>
        </Style>
        
        <!-- Image Animation Styles -->
        <Style Selector="Image.PageImage">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Image.PageImage.Loaded">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
             <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        
        <!-- Custom Flyout Style -->
        <Style Selector="FlyoutPresenter.TransparentFlyout">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- BoxShadow is not a direct property of FlyoutPresenter in this context, removing it to fix build -->
        </Style>

        <!-- Modern ScrollBar Style -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#80FFFFFF"/>
        </Style>

        <!-- Custom iOS/Mac-style Thick Slider -->
        <Style Selector="Slider.IosSlider">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Height="24"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Track (Intercepts Clicks) -->
                            <Track Name="PART_Track" 
                                   Minimum="{TemplateBinding Minimum}" 
                                   Maximum="{TemplateBinding Maximum}" 
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Orientation="Horizontal">
                                   
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <!-- Flat edges rely on parent Border's ClipToBounds for perfect capping at 0% and 100% -->
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseButton>

                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton" Background="Transparent" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseButton>

                                <!-- Zero-width logical thumb allowing the fill bar to naturally span 0-100% smoothly without layout offsets -->
                                <Thumb Name="PART_SliderThumb" Width="0" Height="24" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <!-- Transparent drag hit-box that extends 12px out in both directions so it remains easy to grab -->
                                            <Border Background="Transparent" 
                                                    Width="24" Height="24"
                                                    Margin="-12,0,-12,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Slider.IosSlider[Orientation=Vertical]">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Width="24"
                            ClipToBounds="True">
                        <Grid>
                            <Track Name="PART_Track" 
                                   Minimum="{TemplateBinding Minimum}" 
                                   Maximum="{TemplateBinding Maximum}" 
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   IsDirectionReversed="False"
                                   Orientation="Vertical">
                                   
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <!-- Fills from bottom-up naturally -->
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" Margin="0,-24,0,0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseButton>

                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton" Background="Transparent" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseButton>

                                <Thumb Name="PART_SliderThumb" Width="24" Height="0" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <!-- Transparent drag hit-box that extends 12px out vertically -->
                                            <Border Background="Transparent" 
                                                    Width="24" Height="24"
                                                    Margin="0,-12,0,-12" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>        
    </UserControl.Styles>

    <Panel Background="Transparent">
        <!-- Layer 0: Image Render -->
        <Panel>
            <!-- Webtoon Mode -->
            <!-- Virtualizing ListBox for Webtoon Mode -->
            <ListBox x:Name="MainListBox"
                     IsVisible="{Binding IsWebtoon}"
                     Background="Black"
                     ItemsSource="{Binding Pages}" 
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.ScrollChanged="OnScrollChanged"
                     SelectionMode="Single">
                     <ListBox.Transitions>
                         <Transitions>
                             <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                         </Transitions>
                     </ListBox.Transitions>
                     <ListBox.Styles>
                         <!-- Remove ListBoxItem default padding/margin/hover -->
                         <Style Selector="ListBoxItem">
                             <Setter Property="Padding" Value="0"/>
                             <Setter Property="Margin" Value="0"/>
                             <Setter Property="Template">
                                 <ControlTemplate>
                                     <ContentPresenter Name="PART_ContentPresenter"
                                                       Background="{TemplateBinding Background}"
                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                                       Content="{TemplateBinding Content}"
                                                       Padding="{TemplateBinding Padding}"
                                                       VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                 </ControlTemplate>
                             </Setter>
                         </Style>
                         <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                             <Setter Property="Background" Value="Transparent"/>
                         </Style>
                         <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                             <Setter Property="Background" Value="Transparent"/>
                         </Style>
                     </ListBox.Styles>
                     
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                     <ListBox.ItemTemplate>
                         <DataTemplate x:DataType="vm:PageViewModel">
                             <!-- Removing AttachedToVisualTree to prevent all items loading instantly. ReaderViewModel.PreloadAroundIndex will handle lazy loading via scroll position. -->
                             <Panel Margin="0"
                                    x:CompileBindings="False"
                                    MaxWidth="{Binding DataContext.WebtoonWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HorizontalAlignment="Center">
                                 <Grid MinHeight="150">
                                     <!-- Loading Indicator -->
                                     <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding IsLoading}">
                                         <TextBlock Text="Loading..." Foreground="#555" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                     </StackPanel>

                                     <!-- Image (Always participates in layout bounds to prevent VirtualizingStackPanel overlap bugs) -->
                                     <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top">
                                         <LayoutTransformControl.LayoutTransform>
                                             <RotateTransform Angle="{Binding DataContext.RotationAngle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                         </LayoutTransformControl.LayoutTransform>
                                         <Image Classes="PageImage"
                                                Classes.Loaded="{Binding !IsLoading}"
                                                Source="{Binding Image}" 
                                                Stretch="Uniform">
                                             <Image.Effect>
                                                 <BlurEffect Radius="{Binding BlurRadius}"/>
                                             </Image.Effect>
                                         </Image>
                                     </LayoutTransformControl>
                                 </Grid>
                             </Panel>
                         </DataTemplate>
                     </ListBox.ItemTemplate>
                 </ListBox>

            <!-- Paged Mode -->
            <Grid IsVisible="{Binding IsPaged}" Background="Black">
                <ScrollViewer x:Name="PagedScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                                <RotateTransform Angle="{Binding RotationAngle}"/>
                            </TransformGroup>
                        </LayoutTransformControl.LayoutTransform>

                        <ContentControl Content="{Binding CurrentPage}"
                                        MaxHeight="{Binding Bounds.Height, ElementName=PagedScroll, Converter={x:Static vm:MathConverters.FitScale}}"
                                        MaxWidth="{Binding Bounds.Width, ElementName=PagedScroll, Converter={x:Static vm:MathConverters.FitScale}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:PageViewModel">
                                     <Panel>
                                         <TextBlock Text="Loading..." Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsVisible="{Binding IsLoading}"/>

                                         <Grid>
                                             <Image Source="{Binding Image}" Stretch="Uniform" Margin="10"
                                                    IsVisible="{Binding !IsLoading}">
                                                 <Image.Effect>
                                                     <BlurEffect Radius="{Binding BlurRadius}"/>
                                                 </Image.Effect>
                                             </Image>
                                         </Grid>
                                     </Panel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </LayoutTransformControl>
                </ScrollViewer>
            </Grid>

            <!-- Dual Paged Mode (Manga Right-to-Left) -->
            <Grid IsVisible="{Binding IsDualPage}" Background="Black">
                <ScrollViewer x:Name="DualPagedScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                                <RotateTransform Angle="{Binding RotationAngle}"/>
                            </TransformGroup>
                        </LayoutTransformControl.LayoutTransform>

                        <Grid ColumnDefinitions="*,*" HorizontalAlignment="Center" VerticalAlignment="Center"
                              MaxHeight="{Binding Bounds.Height, ElementName=DualPagedScroll, Converter={x:Static vm:MathConverters.FitScale}}"
                              MaxWidth="{Binding Bounds.Width, ElementName=DualPagedScroll, Converter={x:Static vm:MathConverters.FitScale}}">
                            <!-- Left Side: Next Page (Index + 1) -->
                            <ContentControl Content="{Binding CurrentPageLeft}" Grid.Column="0">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:PageViewModel">
                                         <Panel>
                                             <TextBlock Text="Loading..." Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsLoading}"/>
                                             <Grid>
                                                 <Image Source="{Binding Image}" Stretch="Uniform" Margin="10"
                                                        IsVisible="{Binding !IsLoading}">
                                                     <Image.Effect>
                                                         <BlurEffect Radius="{Binding BlurRadius}"/>
                                                     </Image.Effect>
                                                 </Image>
                                             </Grid>
                                         </Panel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                            <!-- Right Side: Current Page (Index) -->
                            <ContentControl Content="{Binding CurrentPageRight}" Grid.Column="1">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:PageViewModel">
                                         <Panel>
                                             <TextBlock Text="Loading..." Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsLoading}"/>
                                             <Grid>
                                                 <Image Source="{Binding Image}" Stretch="Uniform" Margin="10"
                                                        IsVisible="{Binding !IsLoading}">
                                                     <Image.Effect>
                                                         <BlurEffect Radius="{Binding BlurRadius}"/>
                                                     </Image.Effect>
                                                 </Image>
                                             </Grid>
                                         </Panel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </Grid>
                    </LayoutTransformControl>
                </ScrollViewer>

                <!-- Navigation Buttons Overlay (Visible only in Dual Page Mode) -->
                <!-- Left Button: Next Page (Right-to-Left reading) -->
                <Button Command="{Binding NextPageCommand}" 
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Width="100" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip.Tip="Next Page">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Style>
                    </Button.Styles>
                    <Viewbox Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
                        <Viewbox.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                            </Transitions>
                        </Viewbox.Transitions>
                        <Viewbox.Styles>
                            <Style Selector="Button:pointerover Viewbox">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Style>
                        </Viewbox.Styles>
                        <Canvas Width="24" Height="24">
                            <Path Data="M15 6l-6 6l6 6" Stroke="White" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                
                <!-- Right Button: Previous Page (Right-to-Left reading) -->
                <Button Command="{Binding PrevPageCommand}" 
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Width="100" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" ToolTip.Tip="Previous Page">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="#33FFFFFF"/>
                        </Style>
                    </Button.Styles>
                    <Viewbox Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
                        <Viewbox.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                            </Transitions>
                        </Viewbox.Transitions>
                        <Viewbox.Styles>
                            <Style Selector="Button:pointerover Viewbox">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Style>
                        </Viewbox.Styles>
                        <Canvas Width="24" Height="24">
                            <Path Data="M9 6l6 6l-6 6" Stroke="White" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
            
            <!-- AutoScroll Anchor (Hidden by Default) -->
            <Canvas Name="AutoScrollCanvas" IsVisible="False" IsHitTestVisible="False" ZIndex="100">
                 <Border Name="AutoScrollAnchor" Width="40" Height="40" CornerRadius="20" 
                         Background="#80000000" BorderBrush="White" BorderThickness="2"
                         BoxShadow="0 4 15 0 #40000000"
                         Margin="-20,-20,0,0"> <!-- Centered via negative margin -->
                     <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-2">
                         <Viewbox Width="12" Height="12" HorizontalAlignment="Center">
                             <Canvas Width="24" Height="24">
                                 <Path Data="M6 9l6 6l6 -6" Stroke="White" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                             </Canvas>
                         </Viewbox>
                         <Viewbox Width="12" Height="12" HorizontalAlignment="Center">
                             <Canvas Width="24" Height="24">
                                 <Path Data="M6 15l6 -6l6 6" Stroke="White" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                             </Canvas>
                         </Viewbox>
                     </StackPanel>
                 </Border>
            </Canvas>
        </Panel>



        <!-- Layer 2: HUD (Head Up Display) -->
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Top Menu (Header) - Restored & Styled -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" Opacity="0.95"
                    IsVisible="{Binding IsHeaderVisible}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Padding="20,10" BorderThickness="0">

                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Back Button (Left) -->
                    <Button Grid.Column="0" Classes="NavBtn" HotKey="Escape"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#18FFFFFF"
                            BorderBrush="#45FFFFFF"
                            BorderThickness="1"
                            Width="38" Height="38"
                            CornerRadius="19"
                            Padding="0"
                            ToolTip.Tip="Back">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#65FFFFFF"/>
                            </Style>
                        </Button.Styles>
                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 12l14 0 M5 12l6 6 M5 12l6 -6" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Title Info (Center) -->
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                         <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="16"
                                    TextTrimming="CharacterEllipsis" MaxLines="1"/>
                         <TextBlock Text="{Binding ChapterTitle}" Foreground="{DynamicResource SecondaryText}" FontSize="12" HorizontalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>

                    <!-- Right Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Refresh Button -->
                        <Button Classes="NavBtn" 
                                Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Refresh">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        
                        <!-- Fullscreen Button -->
                        <Button Classes="NavBtn" 
                                Command="{Binding ToggleFullscreenCommand}"
                                ToolTip.Tip="Toggle Fullscreen">
                            <Panel>
                                <Viewbox Width="18" Height="18" IsVisible="{Binding !IsFullscreen}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4 8v-2a2 2 0 0 1 2 -2h2 M4 16v2a2 2 0 0 0 2 2h2 M16 4h2a2 2 0 0 1 2 2v2 M16 20h2a2 2 0 0 0 2 -2v-2" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <Viewbox Width="18" Height="18" IsVisible="{Binding IsFullscreen}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M5 9h4v-4 M5 15h4v4 M19 9h-4v-4 M19 15h-4v4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Panel>
                        </Button>
                        
                        <!-- Reading Mode -->
                        <Button Classes="NavBtn" ToolTip.Tip="Reading Mode">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard" FlyoutPresenterClasses="TransparentFlyout">
                                    <Border Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="8" BorderBrush="{DynamicResource HoverBackground}" BorderThickness="1" MinWidth="160" BoxShadow="0 8 24 0 #30000000">
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <Button Background="Transparent" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="8"
                                                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ReaderMode.Webtoon}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="0">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z M4 12l16 0 M12 4l0 16" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1" Text="Webtoon" VerticalAlignment="Center"/>
                                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsWebtoon}" Grid.Column="2">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M5 12l5 5l10 -10" Stroke="{DynamicResource AccentColor}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Background="Transparent" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="8"
                                                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ReaderMode.Single}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="0">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1" Text="Single Page" VerticalAlignment="Center"/>
                                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsPaged}" Grid.Column="2">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M5 12l5 5l10 -10" Stroke="{DynamicResource AccentColor}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Background="Transparent" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" CornerRadius="8"
                                                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:ReaderMode.Double}">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Grid.Column="0">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12 M19 16h-12a2 2 0 0 0 -2 2 M9 8h6" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Grid.Column="1" Text="Dual Page" VerticalAlignment="Center"/>
                                                    <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDualPage}" Grid.Column="2">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M5 12l5 5l10 -10" Stroke="{DynamicResource AccentColor}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5 5a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1l0 -14 M9 5a1 1 0 0 1 1 -1h2a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1l0 -14 M5 8h4 M9 16h4 M13.803 4.56l2.184 -.53c.562 -.135 1.133 .19 1.282 .732l3.695 13.418a1.02 1.02 0 0 1 -.634 1.219l-.133 .041l-2.184 .53c-.562 .135 -1.133 -.19 -1.282 -.732l-3.695 -13.418a1.02 1.02 0 0 1 .634 -1.219l.133 -.041 M14 9l4 -1 M16 16l3.923 -.98" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Zoom Controls -->
                        <Button Classes="NavBtn" ToolTip.Tip="Zoom Options">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard" FlyoutPresenterClasses="TransparentFlyout">
                                    <Border Background="{DynamicResource SidebarBackground}" CornerRadius="16" Padding="15,20" BorderBrush="{DynamicResource HoverBackground}" BorderThickness="1" MinWidth="100" BoxShadow="0 8 24 0 #30000000">
                                        <StackPanel Orientation="Vertical" Spacing="10" HorizontalAlignment="Center">
                                            <!-- Value Label -->
                                            <TextBlock Text="{Binding ZoomScale, StringFormat='{}{0:P0}'}" Foreground="{DynamicResource AccentColor}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                            
                                            <!-- Slider -->
                                            <Slider Classes="IosSlider"
                                                    Orientation="Vertical"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Background="{DynamicResource HoverBackground}"
                                                    Value="{Binding ZoomScale}" 
                                                    Minimum="0.1" Maximum="2.0" 
                                                    Height="140"
                                                    IsSnapToTickEnabled="True" 
                                                    TickFrequency="0.1"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Menu (Fixed Bottom Bar) -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}" Opacity="0.95"
                    IsVisible="{Binding IsFooterVisible}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    Padding="30,15">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center" MaxWidth="1200" HorizontalAlignment="Stretch">
                        
                        <!-- Prev (Icon Only) -->
                        <Button Grid.Column="0" Classes="NavBtn" 
                                Command="{Binding PrevChapterCommand}"
                                IsEnabled="{Binding HasPrevChapter}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#18FFFFFF"
                                BorderBrush="#45FFFFFF"
                                BorderThickness="1"
                                Width="38" Height="38"
                                CornerRadius="19"
                                Padding="0"
                                ToolTip.Tip="Previous Chapter">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#65FFFFFF"/>
                                </Style>
                                <Style Selector="Button:disabled /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#08FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Style>
                            </Button.Styles>
                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5 12l14 0 M5 12l6 6 M5 12l6 -6" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Slider & Page Indicator (Center) -->
                        <Panel Grid.Column="1" Margin="15,0">
                            <!-- Slider -->
                            <Slider Name="ProgressSlider"
                                    Classes="IosSlider"
                                    Foreground="{DynamicResource PrimaryAccent}"
                                    Background="{DynamicResource HoverBackground}"
                                    Focusable="False"
                                    Minimum="0" 
                                    Maximum="{Binding Pages.Count, Converter={x:Static vm:MathConverters.SubtractOne}}" 
                                    Value="{Binding CurrentPageIndex, Mode=TwoWay}"
                                    ValueChanged="OnSliderValueChanged"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"/>

                            <!-- Page Indicator (Overlaid) -->
                            <Border Background="Transparent" CornerRadius="12" Padding="12,4" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Page" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" Opacity="0.9"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding CurrentPageIndex, Converter={x:Static vm:MathConverters.AddOne}}" 
                                                   Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="/" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Pages.Count}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!-- Next (Icon Only) -->
                        <Button Grid.Column="2" Classes="NavBtn" 
                                Command="{Binding NextChapterCommand}"
                                IsEnabled="{Binding HasNextChapter}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#18FFFFFF" 
                                BorderBrush="#45FFFFFF"
                                BorderThickness="1"
                                Width="38" Height="38"
                                CornerRadius="19"
                                Padding="0"
                                ToolTip.Tip="Next Chapter">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#65FFFFFF"/>
                                </Style>
                                <Style Selector="Button:disabled /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#08FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#15FFFFFF"/>
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Style>
                            </Button.Styles>
                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5 12l14 0 M13 18l6 -6 M13 6l6 6" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Background="#80000000" IsVisible="False">
            <TextBlock Text="Loading..." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Panel>
</UserControl>
