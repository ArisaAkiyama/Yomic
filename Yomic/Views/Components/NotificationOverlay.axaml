<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yomic.ViewModels"
             x:Class="Yomic.Views.Components.NotificationOverlay"
             x:DataType="vm:NotificationViewModel">
    
    <UserControl.Styles>
        <Style Selector="Border.Toast">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
            <Setter Property="BoxShadow" Value="0 4 12 0 #40000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        
        <!-- Animations -->
        <Style Selector="Border.Toast[IsVisible=True]">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translateY(0)"/>
        </Style>
        <Style Selector="Border.Toast[IsVisible=False]">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(20px)"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Border Classes="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                IsVisible="{Binding IsVisible}">
            <Grid ColumnDefinitions="Auto, *">
                <!-- Icon Container -->
                <Panel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                    <!-- Success Icon (Checkmark: E73E) -->
                    <Border Background="#20A6E3A1" Width="32" Height="32" CornerRadius="16" IsVisible="{Binding IsSuccess}">
                         <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                             <Canvas Width="24" Height="24">
                                 <Path Data="M5 12l5 5l10 -10" Stroke="#A6E3A1" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                             </Canvas>
                         </Viewbox>
                    </Border>
                    
                    <!-- Error Icon (Network Offline: F384) -->
                    <Border Background="#20F38BA8" Width="32" Height="32" CornerRadius="16" IsVisible="{Binding IsError}">
                         <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                             <Canvas Width="24" Height="24">
                                 <Path Data="M18 6l-12 12 M6 6l12 12" Stroke="#F38BA8" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                             </Canvas>
                         </Viewbox>
                    </Border>
                    
                    <!-- Info Icon -->
                    <Border Background="#200078D7" Width="32" Height="32" CornerRadius="16" IsVisible="{Binding IsInfo}">
                         <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                             <Canvas Width="24" Height="24">
                                 <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M12 9h.01 M11 12h1v4h1" Stroke="#0078D7" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                             </Canvas>
                         </Viewbox>
                    </Border>
                </Panel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource PrimaryText}" FontSize="14" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
