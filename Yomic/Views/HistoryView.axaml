<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Yomic.ViewModels"
             xmlns:helpers="clr-namespace:Yomic.Views.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Yomic.Views.HistoryView"
             x:Name="root"
             x:DataType="vm:HistoryViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <UserControl.Styles>
         <!-- Card Style same as Library/SourceFeed -->
         <Style Selector="Border.MangaCard">
             <Setter Property="ZIndex" Value="1"/>
             <Setter Property="Transitions">
                 <Transitions>
                     <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                 </Transitions>
             </Setter>
         </Style>
         <Style Selector="Border.MangaCard:pointerover">
             <Setter Property="ZIndex" Value="10"/>
             <Setter Property="BoxShadow" Value="0 10 20 0 #60000000"/>
             <Setter Property="Cursor" Value="Hand"/>
         </Style>

         <Style Selector="Border.MangaCard Image">
             <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
             <Setter Property="Transitions">
                 <Transitions>
                     <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
                 </Transitions>
             </Setter>
         </Style>
         <Style Selector="Border.MangaCard:pointerover Image">
             <Setter Property="RenderTransform" Value="scale(1.08)"/>
         </Style>
        <!-- Standard Header Action Button Style -->
        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.header-action:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>
        
        <!-- Disable transitions for header buttons to avoid color "lag" -->
        <Style Selector="Button.header-action TextBlock">
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        
        <!-- Hazard/Clear Action Style (Transparent but keeps red icon/text) -->
        <Style Selector="Button.hazard">
            <Setter Property="Foreground" Value="#FF5555"/>
        </Style>
        <Style Selector="Button.hazard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20FF5555"/>
        </Style>
        <Style Selector="Button.header-action.hazard:pointerover">
            <Setter Property="Foreground" Value="#FF7777"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- Online Content -->
        <Panel IsVisible="{Binding !IsOffline}">
            <Grid RowDefinitions="Auto, *">
                <!-- Header (Fixed) -->
                <StackPanel Grid.Row="0" Margin="30,25,30,15" IsVisible="{Binding HasItems}">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12 8l0 4l2 2 M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{DynamicResource String.HistoryHeader}" FontSize="28" FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                            

                        </StackPanel>

                         <!-- Actions: Clear All | Refresh | Toggle -->
                         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasItems}">
                             <!-- Clear All Button -->
                             <Button Command="{Binding ClearHistoryCommand}"
                                     Classes="header-action"
                                     ToolTip.Tip="{DynamicResource String.DeleteAllHistory}">
                                 <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                     <Canvas Width="24" Height="24">
                                         <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                     </Canvas>
                                 </Viewbox>
                             </Button>

                             <!-- Refresh Button -->
                             <Button Command="{Binding RefreshCommand}"
                                     Classes="header-action"
                                     ToolTip.Tip="{DynamicResource String.RefreshHistory}">
                                 <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                     <Canvas Width="24" Height="24">
                                         <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                     </Canvas>
                                 </Viewbox>
                             </Button>

                             <!-- Toggle View Mode Button -->
                             <Button Command="{Binding ToggleViewModeCommand}"
                                     Classes="header-action"
                                     ToolTip.Tip="Toggle View Mode (Grid/List)">
                                 <Panel>
                                     <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsListView}">
                                         <Canvas Width="24" Height="24">
                                             <Path Data="M9 6l11 0 M9 12l11 0 M9 18l11 0 M5 6l0 .01 M5 12l0 .01 M5 18l0 .01" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                         </Canvas>
                                     </Viewbox>
                                     <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsListView}">
                                         <Canvas Width="24" Height="24">
                                             <Path Data="M4 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M14 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M4 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4 M14 15a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                         </Canvas>
                                     </Viewbox>
                                 </Panel>
                             </Button>
                         </StackPanel>
                    </Grid>

                </StackPanel>

                <!-- Scrollable Content -->
                <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="1" Padding="0,0,0,30" IsVisible="{Binding HasItems}"
                              VerticalScrollBarVisibility="Visible" AllowAutoHide="False">
                    <StackPanel>
                        <!-- Grid View Mode -->
                        <ItemsControl ItemsSource="{Binding HistoryItems}" IsVisible="{Binding !IsListView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                 <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="10,0,10,30"
                                         Command="{Binding DataContext.OpenMangaCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                         CommandParameter="{Binding}">
                                     <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </Style>
                                     </Button.Styles>

                                     <Button.ContextMenu>
                                         <ContextMenu>
                                             <MenuItem Header="{DynamicResource String.RemoveFromHistory}" 
                                                       x:CompileBindings="False"
                                                       Command="{Binding #root.DataContext.RemoveHistoryItemCommand}"
                                                       CommandParameter="{Binding}"
                                                       Foreground="#FF5555">
                                                 <MenuItem.Icon>
                                                     <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                         <Canvas Width="24" Height="24">
                                                             <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="#FF5555" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                         </Canvas>
                                                     </Viewbox>
                                                 </MenuItem.Icon>
                                             </MenuItem>
                                         </ContextMenu>
                                     </Button.ContextMenu>
                                     
                                    <StackPanel Width="150" Spacing="8">
                                        <!-- Cover Image -->
                                        <Border Classes="MangaCard" Width="150" Height="225" CornerRadius="12" 
                                                Background="{DynamicResource SidebarBackground}" ClipToBounds="True"
                                                BoxShadow="0 4 10 0 #40000000">
                                            <Grid>
                                                <Image helpers:SecureImageLoader.Url="{Binding CoverUrl}" 
                                                       helpers:SecureImageLoader.DecodeWidth="300"
                                                       Stretch="UniformToFill"/>
                                                
                                                 <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                                         Width="100" Height="18" Margin="-32,9,0,0"
                                                         Background="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.Instance}}"
                                                         IsVisible="{Binding Status, Converter={x:Static vm:StatusToColorConverter.StatusToVisibility}}">
                                                     <Border.RenderTransform>
                                                         <RotateTransform Angle="-45"/>
                                                     </Border.RenderTransform>
                                                     <TextBlock Text="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.ToUpperConverter}}" 
                                                                FontSize="8" FontWeight="900" Foreground="White"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                 </Border>

                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="4" Margin="8">
                                                     <!-- NEW Badge -->
                                                     <Border Background="#89B4FA" CornerRadius="6"
                                                             Padding="6,2"
                                                             IsVisible="{Binding IsNewBadgeVisible}">
                                                         <TextBlock Text="{DynamicResource String.Badge.New}" Foreground="#1E1E2E"
                                                                    FontSize="10" FontWeight="Bold"/>
                                                     </Border>
                                                 </StackPanel>
                                                
                                                <!-- Last Read Badge -->
                                                <Border Background="{DynamicResource OverlayBackground}" Opacity="0.9" CornerRadius="6" 
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="8" Padding="6,4">
                                                    <TextBlock Text="{Binding LastReadTime}" Foreground="{DynamicResource PrimaryText}" 
                                                               FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Title Below Image -->
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" 
                                                   TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                                   FontSize="13" FontWeight="SemiBold" MaxLines="2"
                                                   ToolTip.Tip="{Binding Title}"/>
                                    </StackPanel>
                                 </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- List View Mode -->
                        <ListBox x:Name="HistoryListModeBox" ItemsSource="{Binding HistoryItems}" 
                                 Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 IsVisible="{Binding IsListView}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                     <Setter Property="Padding" Value="0"/>
                                     <Setter Property="Margin" Value="0"/>
                                     <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" Margin="30,0,30,0"/> 
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                     <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="0,0,0,4"
                                             Command="{Binding DataContext.OpenMangaCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                             CommandParameter="{Binding}"
                                             HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                         <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                            </Style>
                                         </Button.Styles>
                                         
                                         <Border CornerRadius="8" Padding="8" Background="Transparent">
                                             <Border.ContextMenu>
                                                 <ContextMenu>
                                                     <MenuItem Header="{DynamicResource String.RemoveFromHistory}" 
                                                               x:CompileBindings="False"
                                                               Command="{Binding #root.DataContext.RemoveHistoryItemCommand}"
                                                               CommandParameter="{Binding}"
                                                               Foreground="#FF5555">
                                                         <MenuItem.Icon>
                                                             <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                                 <Canvas Width="24" Height="24">
                                                                     <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="#FF5555" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                                 </Canvas>
                                                             </Viewbox>
                                                         </MenuItem.Icon>
                                                     </MenuItem>
                                                 </ContextMenu>
                                             </Border.ContextMenu>

                                            <Grid ColumnDefinitions="60, 16, *, Auto">
                                                <Border Grid.Column="0" Height="80" Width="60" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SidebarBackground}">
                                                    <Image helpers:SecureImageLoader.Url="{Binding CoverUrl}" 
                                                           helpers:SecureImageLoader.DecodeWidth="300"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                
                                                <Grid Grid.Column="2" VerticalAlignment="Center" RowDefinitions="Auto, Auto">
                                                    <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" 
                                                               TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                                               FontSize="14" FontWeight="SemiBold" MaxLines="1"/>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding SourceName}" Foreground="{DynamicResource SecondaryText}" 
                                                                   FontSize="12" Opacity="0.7" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding SourceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="·" Foreground="{DynamicResource SecondaryText}" FontSize="12" Opacity="0.5"
                                                                   IsVisible="{Binding LastReadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding LastReadTime}" Foreground="{DynamicResource SecondaryText}" 
                                                                   FontSize="12" Opacity="0.6" MaxLines="1"
                                                                   IsVisible="{Binding LastReadTime, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Background="#89B4FA" CornerRadius="4" Padding="6,2"
                                                            IsVisible="{Binding IsNewBadgeVisible}">
                                                        <TextBlock Text="{DynamicResource String.Badge.New}" Foreground="#1E1E2E" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                     <Border Background="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.Instance}}" 
                                                             CornerRadius="4" Padding="6,2"
                                                             IsVisible="{Binding Status, Converter={x:Static vm:StatusToColorConverter.StatusToVisibility}}">
                                                         <TextBlock Text="{Binding StatusString, Converter={x:Static vm:StatusToColorConverter.ToUpperConverter}}" 
                                                                    Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                     </Border>
                                                </StackPanel>
                                            </Grid>
                                         </Border>
                                     </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Margin="0,0,30,24" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsLoadingMore}">
                            <helpers:LoadingArcs Width="34" Height="34"/>
                            <TextBlock Text="{DynamicResource String.LoadingMore}" Foreground="{DynamicResource SecondaryText}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding !HasItems}">
                    <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 8l0 4l2 2 M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5" Stroke="#45475A" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource String.NoHistory}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String.NoHistoryDesc}" FontSize="14" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Panel>

        <!-- Skeleton Loading (replaces dark overlay) -->
        <Border IsVisible="{Binding IsRefreshing}">
            <WrapPanel Orientation="Horizontal" Margin="30,100,30,30">
                <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                    <Border Classes="SkeletonCard" Height="225" Width="150"/>
                    <Border Classes="SkeletonText" Width="120" Height="14"/>
                </StackPanel>
                <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                    <Border Classes="SkeletonCard" Height="225" Width="150"/>
                    <Border Classes="SkeletonText" Width="100" Height="14"/>
                </StackPanel>
                <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                    <Border Classes="SkeletonCard" Height="225" Width="150"/>
                    <Border Classes="SkeletonText" Width="130" Height="14"/>
                </StackPanel>
                <StackPanel Width="150" Margin="10,0,10,20" Spacing="8">
                    <Border Classes="SkeletonCard" Height="225" Width="150"/>
                    <Border Classes="SkeletonText" Width="110" Height="14"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Offline State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding IsOffline}">
            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a7.963 7.963 0 0 1 3.864 -2.14m4.163 .155a7.965 7.965 0 0 1 3.287 2 M3.515 9.515a12 12 0 0 1 3.544 -2.455m3.101 -.92a12 12 0 0 1 10.325 3.374 M3 3l18 18" Stroke="#F38BA8" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel Spacing="8">
                <TextBlock Text="No Internet Connection" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="You are currently offline. Please check your network settings." Foreground="{DynamicResource SecondaryText}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
