<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Yomic.ViewModels"
             xmlns:helpers="clr-namespace:Yomic.Views.Helpers"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Yomic.Views.MangaDetailView"
             x:DataType="vm:MangaDetailViewModel">

    <Grid>
        <!-- LAYER 2: INTERACTIVE CONTENT (Scrollable) -->
        <!-- A single ScrollViewer wraps both the static header and the virtualized chapter list.   -->
        <!-- This allows UI virtualization to work correctly since the ListBox only contains        -->
        <!-- chapter rows (uniform height), while the large header lives outside the ListBox.       -->
        <ScrollViewer x:Name="MainScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- STATIC HEADER: Cover, Info, Actions, Synopsis, Divider -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid Background="{DynamicResource PrimaryBackground}">
                    <!-- AMBIENT BACKGROUND (scrolls with header) -->
                    <Grid ClipToBounds="True" Height="650" VerticalAlignment="Top">
                        <StackPanel>
                            <Image helpers:SecureImageLoader.Url="{Binding ThumbnailUrl}"
                                   helpers:SecureImageLoader.DecodeWidth="300"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   Margin="-100">
                                <Image.Effect>
                                    <BlurEffect Radius="30"/>
                                </Image.Effect>
                            </Image>
                        </StackPanel>
                        <!-- 20% Black Overlay -->
                        <Rectangle Fill="Black" Opacity="0.2"/>
                        <!-- Gradient Fade to Theme Color -->
                        <Rectangle Fill="{DynamicResource MangaFadeGradient}"/>
                    </Grid>

                    <!-- Back Button (Soft Translucent Overlay) -->
                    <Button Click="OnBackClick" HotKey="Escape" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,30,0,0"
                            Width="40" Height="40" CornerRadius="20" Padding="0"
                            Background="#35FFFFFF" BorderThickness="0"
                            Foreground="White"
                            ToolTip.Tip="Back (Esc)">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="#25FFFFFF"/>
                            </Style>
                        </Button.Styles>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 12l14 0 M5 12l6 6 M5 12l6 -6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- HEADER CONTENT -->
                    <Grid RowDefinitions="*, Auto" ColumnDefinitions="Auto, *" Margin="40,100,40,20">
                        <!-- Left Column: Sharp Cover Image -->
                        <Border Grid.Column="0"
                                Width="230" Height="345"
                                CornerRadius="12"
                                ClipToBounds="True"
                                Margin="0,0,40,0"
                                VerticalAlignment="Top"
                                BoxShadow="0 15 30 0 #60000000">
                            <Image helpers:SecureImageLoader.Url="{Binding ThumbnailUrl}"
                                   helpers:SecureImageLoader.DecodeWidth="300"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- Right Column: Info & Actions -->
                        <StackPanel Grid.Column="1" Spacing="0">
                            <!-- Title -->
                            <TextBlock Text="{Binding Title}"
                                       FontSize="36" FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Margin="0,0,0,10"/>

                            <!-- Author & Status Row -->
                            <StackPanel Orientation="Vertical" Spacing="8" Margin="0,0,0,20">
                                <!-- Author -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0 M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Author}" Foreground="{DynamicResource SecondaryText}" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>

                                <!-- Status with Timer Icon -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M12 7v5l3 3" Stroke="{Binding Status, Converter={x:Static vm:StatusToColorConverter.Instance}}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={x:Static vm:StatusToColorConverter.Instance}}"
                                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Source Info -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="16" Height="16" CornerRadius="4" ClipToBounds="True"
                                            IsVisible="{Binding SourceIconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding SourceIconBitmap}" Stretch="UniformToFill"/>
                                    </Border>
                                    <TextBlock Text="{Binding SourceName}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Rating Stars -->
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0"
                                            IsVisible="{Binding HasRating}">
                                    <Panel>
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                      Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <PathIcon Data="{Binding Star1Char}" Width="16" Height="16" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <Panel>
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                      Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <PathIcon Data="{Binding Star2Char}" Width="16" Height="16" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <Panel>
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                      Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <PathIcon Data="{Binding Star3Char}" Width="16" Height="16" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <Panel>
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                      Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <PathIcon Data="{Binding Star4Char}" Width="16" Height="16" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <Panel>
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                      Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <PathIcon Data="{Binding Star5Char}" Width="16" Height="16" Foreground="{DynamicResource PrimaryAccent}" VerticalAlignment="Center"/>
                                    </Panel>
                                    <TextBlock Text="{Binding RatingText}" Foreground="{DynamicResource SecondaryText}" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- GENRES -->
                            <ItemsControl ItemsSource="{Binding Genres}" Margin="0,0,0,25">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16" Padding="12,6" Margin="0,0,8,8"
                                                BorderThickness="1"
                                                Background="{Binding Converter={x:Static vm:StatusToColorConverter.GenreToBackground}}"
                                                BorderBrush="{Binding Converter={x:Static vm:StatusToColorConverter.GenreToBorder}}">
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       Foreground="{Binding Converter={x:Static vm:StatusToColorConverter.GenreToForeground}}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Action Buttons -->
                            <StackPanel Spacing="20" Margin="0,5,0,30">
                                <UniformGrid Rows="1" Columns="5">
                                    <UniformGrid.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter,
                                                       Button:pressed /template/ ContentPresenter,
                                                       Button:focus /template/ ContentPresenter,
                                                       Button:disabled /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Style>
                                    </UniformGrid.Styles>

                                    <!-- Read Now / Resume -->
                                    <Button Command="{Binding ResumeReadingCommand}"
                                            CommandParameter="{Binding NextChapterToRead}"
                                            IsEnabled="{Binding Chapters.Count}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M7 4v16l13 -8l-13 -8" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding ResumeButtonText}" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Library Toggle -->
                                    <Button Command="{Binding ToggleLibraryCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Panel>
                                                <!-- Not in Library (Outline) -->
                                                <Viewbox Width="26" Height="26" HorizontalAlignment="Center" IsVisible="{Binding !InLibrary}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" 
                                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <!-- In Library (Filled Red) -->
                                                <Viewbox Width="26" Height="26" HorizontalAlignment="Center" IsVisible="{Binding InLibrary}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" 
                                                              Stroke="Red" StrokeThickness="2" Fill="Red" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Panel>
                                            <TextBlock Text="{Binding InLibrary, Converter={x:Static vm:StatusToColorConverter.BoolToLibraryText}}"
                                                       FontSize="11" HorizontalAlignment="Center"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Open in Browser -->
                                    <Button Command="{Binding OpenWebViewCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Browser" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Refresh -->
                                    <Button Command="{Binding RefreshCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Refresh" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Download -->
                                    <Button Command="{Binding DownloadAllCommand}">
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4l0 12" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Download" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Description / Synopsis -->
                            <TextBlock Text="Synopsis" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8" FontSize="16"/>

                            <!-- Collapsed Description -->
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="22"
                                       MaxLines="6"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding !IsSynopsisExpanded}"/>

                            <!-- Expanded Description -->
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="22"
                                       IsVisible="{Binding IsSynopsisExpanded}"/>

                            <!-- Toggle Expand Synopsis -->
                            <Button Command="{Binding ToggleSynopsisCommand}"
                                    Click="OnSynopsisToggleClick"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="10,5" Margin="0,5,0,0"
                                    HorizontalAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Foreground" Value="#0078D7"/>
                                    </Style>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Foreground" Value="#5AB0FF"/>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Button.Styles>
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round">
                                            <Path.Data>
                                                <MultiBinding Converter="{x:Static vm:StatusToColorConverter.BoolToExpandText}">
                                                    <Binding Path="IsSynopsisExpanded"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <!-- Chapters Divider (anchored to bottom of header grid) -->
                        <Grid x:Name="ChaptersDivider" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,35,0,15" ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Chapters" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Background="#18FFFFFF" CornerRadius="12" BorderBrush="#45FFFFFF" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VisibleChaptersCount}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <!-- Filter Menu -->
                                <Button Background="#011E1E2E" BorderThickness="0" Padding="8,4">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="All Chapters" Command="{Binding SetChapterFilterCommand}" CommandParameter="All">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="M5 12l5 5l10 -10" Width="14" Height="14" IsVisible="{Binding IsFilterAll}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Unread Only" Command="{Binding SetChapterFilterCommand}" CommandParameter="Unread">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="M5 12l5 5l10 -10" Width="14" Height="14" IsVisible="{Binding IsFilterUnread}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Bookmarked Only" Command="{Binding SetChapterFilterCommand}" CommandParameter="Bookmarked">
                                                <MenuItem.Icon>
                                                    <PathIcon Data="M5 12l5 5l10 -10" Width="14" Height="14" IsVisible="{Binding IsFilterBookmarked}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                         <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                             <Canvas Width="24" Height="24">
                                                 <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                             </Canvas>
                                         </Viewbox>
                                     </StackPanel>
                                </Button>

                                <!-- Delete All Downloads Button -->
                                <Button Command="{Binding DeleteAllDownloadsCommand}"
                                        ToolTip.Tip="Delete All Downloaded Chapters"
                                        Background="#011E1E2E" BorderThickness="0"
                                        Padding="8,4">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#FF5555"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="#FF5555"/>
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>

                                <!-- Sort Button -->
                                <Button Command="{Binding ToggleSortCommand}"
                                        Background="#011E1E2E" BorderThickness="0"
                                        Padding="8,4">
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                         <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                             <Canvas Width="24" Height="24">
                                                 <Path Data="M3 9l4 -4l4 4m-4 -4v14 M21 15l-4 4l-4 -4m4 4v-14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                             </Canvas>
                                         </Viewbox>
                                        <TextBlock Text="{Binding SortAscending, Converter={x:Static vm:StatusToColorConverter.SortToString}}"
                                                   FontSize="12"
                                                   Foreground="{Binding $parent[Button].Foreground}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                <!-- VIRTUALIZED CHAPTER LIST                                                   -->
                <!-- The ListBox now ONLY contains ChapterItems (uniform height ~64px each).    -->
                <!-- Default VirtualizingStackPanel is active — only visible rows use memory.   -->
                <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                <ListBox x:Name="ChaptersListBox"
                         ItemsSource="{Binding FilteredChaptersList}"
                         Background="{DynamicResource PrimaryBackground}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Padding="0,0,0,50">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChapterItem}">
                            <Panel Margin="40,0,40,0" ClipToBounds="True">
                                <!-- 1. Background (Shadow + Hover) -->
                                <Border CornerRadius="8"
                                        BoxShadow="0 2 4 0 #10000000"
                                        Background="{DynamicResource SidebarBackground}">
                                    <Button Click="OnReadClick"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            RenderTransform="none">
                                        <Button.Transitions>
                                            <Transitions>
                                                <BrushTransition Property="Background" Duration="0:0:0.1"/>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.075" Easing="CubicEaseOut"/>
                                            </Transitions>
                                        </Button.Transitions>
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="RenderTransform" Value="scale(0.98)"/>
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#200078D7"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Border>

                                <!-- 2. Content Overlay -->
                                <Grid ColumnDefinitions="*, Auto, Auto" Margin="20,15">
                                    <!-- Text Info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False" Spacing="8">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="15"
                                                   Opacity="{Binding IsRead, Converter={x:Static vm:StatusToColorConverter.BoolToOpacity}}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="260"/>
                                        
                                        <!-- NEW Badge -->
                                        <Border Background="#D20F39" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center"
                                                IsVisible="{Binding IsNewRelease}">
                                            <TextBlock Text="{DynamicResource String.Badge.New}" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bookmark Toggle -->
                                    <Panel Grid.Column="1" Margin="0,0,5,0" IsHitTestVisible="True" VerticalAlignment="Center">
                                        <Button Command="{Binding ToggleBookmarkCommand}" Background="Transparent"
                                                Padding="8" BorderThickness="0" CornerRadius="8" ToolTip.Tip="{DynamicResource String.MangaDetail.ToggleBookmark}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryAccent}"/>
                                                </Style>
                                            </Button.Styles>
                                            <Panel>
                                                <!-- Unbookmarked Star -->
                                                <Viewbox Width="20" Height="20" IsVisible="{Binding !Bookmark}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                              Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <!-- Bookmarked Star (Filled) -->
                                                <Viewbox Width="20" Height="20" IsVisible="{Binding Bookmark}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245" 
                                                              Stroke="{DynamicResource PrimaryAccent}" StrokeThickness="2" Fill="{DynamicResource PrimaryAccent}" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Panel>
                                        </Button>
                                    </Panel>

                                    <!-- Download/Delete Buttons -->
                                    <Panel Grid.Column="2" Margin="0,0,15,0" IsHitTestVisible="True" VerticalAlignment="Center">
                                        <!-- Download (visible when NOT downloaded) -->
                                        <Button Command="{Binding DownloadCommand}" Background="Transparent"
                                                IsVisible="{Binding !IsDownloaded}"
                                                Padding="8" BorderThickness="0" CornerRadius="8"
                                                ToolTip.Tip="{DynamicResource String.MangaDetail.DownloadChapter}"
                                                Foreground="{DynamicResource SecondaryText}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                </Style>
                                            </Button.Styles>
                                            <Panel>
                                                <Viewbox Width="20" Height="20" IsVisible="{Binding !IsDownloading}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4l0 12" 
                                                              Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                                                             IsVisible="{Binding IsDownloading}"
                                                             Foreground="{DynamicResource PrimaryAccent}"/>
                                            </Panel>
                                        </Button>

                                        <!-- Delete (visible when Downloaded) -->
                                        <Button Command="{Binding DeleteCommand}" Background="Transparent"
                                                IsVisible="{Binding IsDownloaded}"
                                                Padding="8" BorderThickness="0" CornerRadius="8"
                                                ToolTip.Tip="{DynamicResource String.MangaDetail.DeleteDownload}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </Button.Styles>
                                            <Panel>
                                                <Viewbox Width="20" Height="20" IsVisible="{Binding !IsDeleting}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" 
                                                              Stroke="#EF4444" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                                                             IsVisible="{Binding IsDeleting}"
                                                             Foreground="#EF4444"/>
                                            </Panel>
                                        </Button>
                                    </Panel>
                                </Grid>

                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </StackPanel>
        </ScrollViewer>

        <!-- STICKY HEADER OVERLAY (shown when ChaptersDivider scrolls off screen) -->
        <Border x:Name="StickyHeader"
                Background="{DynamicResource PrimaryBackground}"
                Height="65"
                VerticalAlignment="Top"
                IsVisible="False"
                ZIndex="5">
            <Grid Margin="40,15,40,15" ColumnDefinitions="Auto, *, Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Chapters" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                    <Border Background="#18FFFFFF" CornerRadius="12" BorderBrush="#45FFFFFF" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Chapters.Count}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Filter Button -->
                    <Button Background="#011E1E2E" BorderThickness="0" Padding="8,4">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="All Chapters" Command="{Binding SetChapterFilterCommand}" CommandParameter="All">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M5 12l5 5l10 -10" Width="14" Height="14" IsVisible="{Binding IsFilterAll}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Unread Only" Command="{Binding SetChapterFilterCommand}" CommandParameter="Unread">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M5 12l5 5l10 -10" Width="14" Height="14" IsVisible="{Binding IsFilterUnread}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Bookmarked Only" Command="{Binding SetChapterFilterCommand}" CommandParameter="Bookmarked">
                                    <MenuItem.Icon>
                                        <PathIcon Data="M5 12l5 5l10 -10" Width="14" Height="14" IsVisible="{Binding IsFilterBookmarked}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                    </Button>

                    <!-- Delete All Downloads Button -->
                    <Button Command="{Binding DeleteAllDownloadsCommand}"
                            ToolTip.Tip="Delete All Downloaded Chapters"
                            Background="#011E1E2E" BorderThickness="0"
                            Padding="8,4">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF5555"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="#FF5555"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                    </Button>

                    <!-- Sort Button -->
                    <Button Command="{Binding ToggleSortCommand}"
                            Background="#011E1E2E" BorderThickness="0"
                            Padding="8,4">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3 9l4 -4l4 4m-4 -4v14 M21 15l-4 4l-4 -4m4 4v-14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding SortAscending, Converter={x:Static vm:StatusToColorConverter.SortToString}}"
                                       FontSize="12"
                                       Foreground="{Binding $parent[Button].Foreground}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay (Premium Skeleton Shimmer) -->
        <Grid IsVisible="{Binding IsLoadingChapters}" Background="{DynamicResource PrimaryBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- FAKE HEADER -->
                    <Grid Height="650" VerticalAlignment="Top">
                        <helpers:SkeletonCard CornerRadius="0" Margin="-100"/>
                        <Rectangle Fill="Black" Opacity="0.2"/>
                        <Rectangle Fill="{DynamicResource MangaFadeGradient}"/>
                    </Grid>

                    <Grid RowDefinitions="*, Auto" ColumnDefinitions="Auto, *" Margin="40,100,40,20" VerticalAlignment="Top">
                        <!-- Fake Cover -->
                        <helpers:SkeletonCard Grid.Column="0" Width="230" Height="345" CornerRadius="12" Margin="0,0,40,0" VerticalAlignment="Top"/>

                        <!-- Fake Info -->
                        <StackPanel Grid.Column="1" Spacing="0">
                            <helpers:SkeletonText Width="400" Height="40" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Vertical" Spacing="8" Margin="0,0,0,20">
                                <helpers:SkeletonText Width="180" Height="20"/>
                                <helpers:SkeletonText Width="120" Height="20"/>
                                <helpers:SkeletonText Width="140" Height="20"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,25">
                                <helpers:SkeletonCard Width="70" Height="28" CornerRadius="14"/>
                                <helpers:SkeletonCard Width="90" Height="28" CornerRadius="14"/>
                                <helpers:SkeletonCard Width="60" Height="28" CornerRadius="14"/>
                            </StackPanel>

                            <StackPanel Spacing="6" Margin="0,60,0,0">
                                <helpers:SkeletonText Width="120" Height="20" Margin="0,0,0,8"/>
                                <helpers:SkeletonText Height="16"/>
                                <helpers:SkeletonText Height="16"/>
                                <helpers:SkeletonText Height="16"/>
                                <helpers:SkeletonText Width="250" Height="16"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- FAKE CHAPTERS LIST -->
                    <StackPanel Margin="40,550,40,20" Spacing="10">
                        <Grid Margin="0,0,0,15">
                            <helpers:SkeletonText Width="160" Height="24" HorizontalAlignment="Left"/>
                        </Grid>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                        <helpers:SkeletonCard Height="64" CornerRadius="8"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Back Button while loading (Soft Translucent Overlay) -->
            <Button Click="OnBackClick" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,30,0,0"
                    Width="40" Height="40" CornerRadius="20" Padding="0"
                    Background="#35FFFFFF" BorderThickness="0"
                    Foreground="White">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#55FFFFFF"/>
                    </Style>
                    <Style Selector="Button:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#25FFFFFF"/>
                    </Style>
                </Button.Styles>
                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M5 12l14 0 M5 12l6 6 M5 12l6 -6" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>

        <!-- CAPTCHA Bypass Loading Overlay -->
        <Border Background="#90000000" IsVisible="{Binding IsBypassing}" ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <helpers:LoadingArcs Margin="0,0,0,10"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding BypassMessage}"
                               Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Please do not close the browser window until finished."
                               Foreground="#B0FFFFFF" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
