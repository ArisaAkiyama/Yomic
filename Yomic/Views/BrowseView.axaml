<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yomic.ViewModels"
             xmlns:helpers="clr-namespace:Yomic.Views.Helpers"
             x:Class="Yomic.Views.BrowseView"
             x:DataType="vm:BrowseViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <UserControl.Styles>
        <!-- Standard Header Action Button Style -->
        <Style Selector="Button.header-action">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
        <Style Selector="Button.header-action:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="Button.header-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>
        <Style Selector="Button.header-action TextBlock">
             <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <!-- Tab Filter Style (ListBoxItem) -->
        <Style Selector="#LanguageFilterListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="#LanguageFilterListBox ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding !IsOffline}">
        <StackPanel Grid.Row="0" Spacing="15" Margin="30,25,30,10" ZIndex="10">
            <!-- Header -->
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{DynamicResource String.BrowseSources}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Search Box & Filter Button -->
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" Width="300" HorizontalAlignment="Left"
                          Text="{Binding SearchText}"
                          Watermark="{DynamicResource String.SearchSources}" 
                          Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" 
                          CornerRadius="20" Padding="8,8,15,8"
                          BorderThickness="0" VerticalContentAlignment="Center" FontSize="13">
                    <TextBox.Styles>
                        <Style Selector="TextBox:focus">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
                        </Style>
                        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                         <Style Selector="TextBox:pointerover">
                             <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                         </Style>
                         <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
                             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                         </Style>
                         <Style Selector="TextBox:focus /template/ TextBlock#PART_Watermark">
                             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                         </Style>
                         <Style Selector="TextBox:pointerover /template/ TextBlock#PART_Watermark">
                             <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                         </Style>
                    </TextBox.Styles>
                    <TextBox.InnerLeftContent>
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </TextBox.InnerLeftContent>
                </TextBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center">
                    <!-- Refresh Status Button -->
                    <Button Command="{Binding RefreshStatusCommand}" 
                            Classes="header-action" Cursor="Hand"
                            ToolTip.Tip="{DynamicResource String.RefreshSourceStatus}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M20 11A8 8 0 0 0 4.5 9M4 5v4h4M4 13a8 8 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Filter Button -->
                    <Button Classes="header-action" ToolTip.Tip="Filter by Language">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Filter By" IsEnabled="False" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                                
                                <MenuItem Header="Show All" Command="{Binding SetLanguageFilterCommand}" CommandParameter="ALL">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedLanguage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ALL'}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Bahasa Indonesia" Command="{Binding SetLanguageFilterCommand}" CommandParameter="ID">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedLanguage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='ID'}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="English" Command="{Binding SetLanguageFilterCommand}" CommandParameter="EN">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding SelectedLanguage, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='EN'}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 12l5 5l10 -10" Stroke="{Binding $parent[MenuItem].Foreground}" StrokeThickness="2.5" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 2v-8.5l-4.48 -4.928a2 2 0 0 1 -.52 -1.345v-2.227" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

            <!-- Main Content (Online) -->
            <Panel Grid.Row="1">
                <ListBox ItemsSource="{Binding Sources}" 
                         Background="Transparent" 
                         BorderThickness="0"
                         Padding="30,10,30,50"
                         VerticalAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsVisible="{Binding HasSources}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button x:CompileBindings="False" Background="Transparent" Padding="0" Margin="0,0,0,4"
                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Button.Styles>
                                
                                <!-- List Item Background -->
                                <Border CornerRadius="8" Padding="15,10"
                                        Background="{DynamicResource SidebarBackground}" BorderThickness="0" BorderBrush="{DynamicResource SeparatorBrush}">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                        </Style>
                                    </Border.Styles>

                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <!-- Col 1: Icon -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="{Binding IconColor}" Margin="0,0,15,0" ClipToBounds="True">
                                             <Panel>
                                                 <TextBlock Text="{Binding IconText}" Foreground="{Binding IconForeground}" FontWeight="ExtraBold" FontSize="20"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            IsVisible="{Binding IconText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                 <Image Source="{Binding IconBitmap}" Stretch="UniformToFill" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                 <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom" 
                                                              Foreground="{DynamicResource PrimaryAccent}" Background="Transparent"
                                                              IsVisible="{Binding IsLoadingIcon}"/>
                                             </Panel>
                                        </Border>
                                        
                                         <!-- Col 2: Name -->
                                         <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                             <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="15"/>
                                         </StackPanel>

                                        <!-- Col 3: Language Flags -->
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding LanguageFlags}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="2" ClipToBounds="True">
                                                        <Image Source="{Binding}" Width="24" Height="16" Stretch="UniformToFill"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                         <!-- Col 4: Action / Status -->
                                         <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                              <!-- Realtime Status Indicator Dot -->
                                              <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,5,0"
                                                      ToolTip.Tip="{Binding StatusTooltip}"
                                                      Classes.online="{Binding IsStatusOnline}"
                                                      Classes.warning="{Binding IsStatusWarning}"
                                                      Classes.offline="{Binding IsStatusOffline}"
                                                      Classes.checking="{Binding IsStatusChecking}"
                                                      Classes.unknown="{Binding IsStatusUnknown}">
                                                  <Border.Styles>
                                                      <Style Selector="Border.online">
                                                          <Setter Property="Background" Value="#22C55E"/>
                                                          <Setter Property="BoxShadow" Value="0 0 8 0 #4022C55E"/>
                                                      </Style>
                                                      <Style Selector="Border.warning">
                                                          <Setter Property="Background" Value="#EAB308"/>
                                                          <Setter Property="BoxShadow" Value="0 0 8 0 #40EAB308"/>
                                                      </Style>
                                                      <Style Selector="Border.offline">
                                                          <Setter Property="Background" Value="#EF4444"/>
                                                          <Setter Property="BoxShadow" Value="0 0 8 0 #40EF4444"/>
                                                      </Style>
                                                      <Style Selector="Border.checking">
                                                          <Setter Property="Background" Value="#3B82F6"/>
                                                          <Style.Animations>
                                                              <Animation Duration="0:0:1" IterationCount="Infinite">
                                                                  <KeyFrame KeyTime="0:0:0">
                                                                      <Setter Property="Opacity" Value="0.3"/>
                                                                  </KeyFrame>
                                                                  <KeyFrame KeyTime="0:0:0.5">
                                                                      <Setter Property="Opacity" Value="1.0"/>
                                                                  </KeyFrame>
                                                                  <KeyFrame KeyTime="0:0:1">
                                                                      <Setter Property="Opacity" Value="0.3"/>
                                                                  </KeyFrame>
                                                              </Animation>
                                                          </Style.Animations>
                                                      </Style>
                                                      <Style Selector="Border.unknown">
                                                          <Setter Property="Background" Value="#6B7280"/>
                                                      </Style>
                                                  </Border.Styles>
                                              </Border>

                                              <!-- WebView Button (Open Browser for CAPTCHA) -->
                                             <Button x:CompileBindings="False"
                                                     Command="{Binding DataContext.OpenWebViewCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     Background="Transparent" BorderThickness="0" Padding="6"
                                                     CornerRadius="16" Cursor="Hand"
                                                     ToolTip.Tip="Open in Browser (Solve CAPTCHA)">
                                                 <Button.Styles>
                                                     <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                         <Setter Property="Background" Value="#20FF9900"/>
                                                     </Style>
                                                 </Button.Styles>
                                                  <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                      <Canvas Width="24" Height="24">
                                                          <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                      </Canvas>
                                                  </Viewbox>
                                             </Button>
                                             
                                             <!-- Arrow -->
                                              <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                                  <Canvas Width="24" Height="24">
                                                      <Path Data="M9 6l6 6l-6 6" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                  </Canvas>
                                              </Viewbox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <!-- Empty State (Online but no sources found) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding !HasSources}">
                    <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="#45475A" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource String.NoSourcesFound}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String.NoSourcesFoundDesc}" Foreground="{DynamicResource SecondaryText}" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </Grid>

        <!-- Offline State -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" IsVisible="{Binding IsOffline}">
            <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a7.963 7.963 0 0 1 3.864 -2.14m4.163 .155a7.965 7.965 0 0 1 3.287 2 M3.515 9.515a12 12 0 0 1 3.544 -2.455m3.101 -.92a12 12 0 0 1 10.325 3.374 M3 3l18 18" Stroke="#F38BA8" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource String.NoInternetConnection}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource String.OfflineMessage}" Foreground="{DynamicResource SecondaryText}" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- CAPTCHA Bypass Loading Overlay -->
        <Border Background="#90000000" IsVisible="{Binding IsBypassing}" ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <helpers:LoadingArcs Margin="0,0,0,10"/>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding BypassMessage}" 
                               Foreground="White" FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource String.BypassWindowWarning}" 
                               Foreground="#B0FFFFFF" FontSize="12" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
