<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yomic.Views.AnnouncementDialog"
        Width="580" Height="520"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="{DynamicResource PrimaryBackground}" CornerRadius="12" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="24">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                <!-- Icon and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#1A0078D4" CornerRadius="10" Width="42" Height="42">
                        <Viewbox Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6 M9 17v1a3 3 0 0 0 6 0v-1" 
                                      Stroke="#0078D4" StrokeThickness="2" Fill="Transparent" 
                                      StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Papan Pengumuman" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Informasi dan pengumuman terbaru seputar Yomic" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Refresh / Status Indicator -->
                <Button Grid.Column="2" x:Name="RefreshButton" Click="OnRefreshClick"
                        Background="Transparent" Padding="8" CornerRadius="6" Cursor="Hand"
                        ToolTip.Tip="Muat ulang pengumuman" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" 
                                  Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" 
                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}" CornerRadius="8" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <!-- Loading State -->
                    <StackPanel x:Name="LoadingContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="False">
                        <ProgressBar IsIndeterminate="True" Width="140" Height="4"/>
                        <TextBlock Text="Memeriksa pengumuman terbaru..." FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="False">
                        <Viewbox Width="36" Height="36" Opacity="0.5">
                            <Canvas Width="24" Height="24">
                                <Path Data="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6 M9 17v1a3 3 0 0 0 6 0v-1" 
                                      Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" 
                                      StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Belum ada pengumuman saat ini." FontSize="13" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Announcements List -->
                    <ScrollViewer x:Name="AnnouncementsScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AnnouncementsContainer" Spacing="10">
                            <!-- Populated dynamically in code-behind -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Actions Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                <Button Content="Tutup" Click="OnCloseClick"
                        Background="{DynamicResource SidebarBackground}" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold"
                        FontSize="13" CornerRadius="4" Padding="24,8" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource SeparatorBrush}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>
