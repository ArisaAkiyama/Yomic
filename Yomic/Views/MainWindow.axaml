<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yomic.ViewModels"
        xmlns:components="using:Yomic.Views.Components"
        x:Class="Yomic.Views.MainWindow"
        Icon="/Assets/app.ico"
        Title="Yomic Desktop"
        Background="Transparent"
        TransparencyLevelHint="Mica"
        ExtendClientAreaToDecorationsHint="True"
        x:DataType="vm:MainWindowViewModel"
        x:Name="MainShell"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="1008">

    <Window.Styles>
        <Style Selector="Button.SidebarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12, 10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Container" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                        <Grid>
                            <!-- Windows 11 Fluent UI Pill Indicator -->
                            <Border Name="SelectionIndicator" Width="3" Height="16" CornerRadius="1.5" Background="#0078D4" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-12,0,0,0"/>
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.SidebarBtn TextBlock.NavIcon">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.SidebarBtn Image.NavIcon">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style Selector="Button.SidebarBtn TextBlock.NavLabel">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="SplitView[IsPaneOpen=True] TextBlock.NavLabel">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Button.SidebarBtn /template/ Border#SelectionIndicator">
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.SidebarBtn:pointerover /template/ Border#Container">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        
        <Style Selector="Button.SidebarBtn.active /template/ Border#Container">
            <Setter Property="Background" Value="#1A0078D4"/>
        </Style>
        
        <Style Selector="Button.SidebarBtn.active /template/ Border#SelectionIndicator">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style Selector="Button.SidebarBtn.active TextBlock.NavIcon">
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Foreground" Value="#0078D4"/>
        </Style>

        <Style Selector="Button.SidebarBtn.active Image.NavIcon">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <Style Selector="Button.SidebarBtn.active TextBlock.NavLabel">
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Announcement Flyout Pill Styles -->
        <Style Selector="Button.AnnouncementPill">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10, 8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.AnnouncementPill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <Style Selector="Button.AnnouncementPill.selected">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>

        <Style Selector="Button.AnnouncementPill.selected TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.AnnouncementPill.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#0078D4"/>
        </Style>

        <Style Selector="Button.ActionLinkBtn">
            <Setter Property="Background" Value="#1A0078D4"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#330078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12, 6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.ActionLinkBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#330078D4"/>
        </Style>

        <Style Selector="Window[WindowState=Normal]">
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="30"/>
        </Style>
        <Style Selector="Window[WindowState=Maximized]">
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="38"/>
        </Style>
        
        <Style Selector="Window[WindowState=Maximized] Panel#RootContainer">
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style Selector="Window[WindowState=FullScreen] Panel#RootContainer">
             <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Styles>

    <Panel Name="RootContainer">
        <!-- Mica Tint (Dark Overlay for better contrast) -->
        <Border Background="{DynamicResource OverlayBackground}" 
                IsHitTestVisible="False"
                IsVisible="{Binding !IsFullscreen}"/>

        <!-- Custom Title Bar Visuals - Hidden in Fullscreen -->
        <Grid Height="30" VerticalAlignment="Top" IsHitTestVisible="False"
              Background="{DynamicResource PrimaryBackground}"
              IsVisible="{Binding !IsFullscreen}">
             <StackPanel Orientation="Horizontal" Spacing="10" Margin="15,0,0,0" VerticalAlignment="Center">
                 <Image Source="/Assets/app.ico" Height="20" Width="20" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                 <TextBlock Text="Yomic" FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
             </StackPanel>

             <!-- Network Status Indicator (Icon-Only Dynamic WiFi Signal) -->
             <Border HorizontalAlignment="Right" Margin="0,0,145,0" VerticalAlignment="Center"
                     Background="Transparent"
                     ToolTip.Tip="{Binding NetworkService.StatusTooltipText}">
                 <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                     <Canvas Width="24" Height="24">
                         <!-- wifi-off (Offline / Disconnected) -->
                         <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a7.963 7.963 0 0 1 3.864 -2.14m4.163 .155a7.965 7.965 0 0 1 3.287 2 M3.515 9.515a12 12 0 0 1 3.544 -2.455m3.101 -.92a12 12 0 0 1 10.325 3.374 M3 3l18 18" 
                               Stroke="#EF4444" StrokeThickness="2" Fill="Transparent" 
                               StrokeLineCap="Round" StrokeJoin="Round"
                               IsVisible="{Binding !NetworkService.IsOnline}"/>

                         <!-- wifi-0 (Online Level 0 - weak / dot) -->
                         <Path Data="M12 18l.01 0" 
                               Stroke="#F97316" StrokeThickness="2" Fill="Transparent" 
                               StrokeLineCap="Round" StrokeJoin="Round"
                               IsVisible="{Binding NetworkService.IsWifiLevel0}"/>

                         <!-- wifi-1 (Online Level 1 - fair / 1 arc) -->
                         <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0" 
                               Stroke="#F59E0B" StrokeThickness="2" Fill="Transparent" 
                               StrokeLineCap="Round" StrokeJoin="Round"
                               IsVisible="{Binding NetworkService.IsWifiLevel1}"/>

                         <!-- wifi-2 (Online Level 2 - good / 2 arcs) -->
                         <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a8 8 0 0 1 11.314 0" 
                               Stroke="#10B981" StrokeThickness="2" Fill="Transparent" 
                               StrokeLineCap="Round" StrokeJoin="Round"
                               IsVisible="{Binding NetworkService.IsWifiLevel2}"/>

                         <!-- wifi (Online Level 3 - excellent / 3 arcs) -->
                         <Path Data="M12 18l.01 0 M9.172 15.172a4 4 0 0 1 5.656 0 M6.343 12.343a8 8 0 0 1 11.314 0 M3.515 9.515c4.686 -4.687 12.284 -4.687 17 0" 
                               Stroke="#10B981" StrokeThickness="2" Fill="Transparent" 
                               StrokeLineCap="Round" StrokeJoin="Round"
                               IsVisible="{Binding NetworkService.IsWifiLevel3}"/>
                     </Canvas>
                 </Viewbox>
             </Border>
        </Grid>

        <!-- Content when NOT fullscreen: SplitView with Sidebar -->
        <SplitView Margin="0,30,0,0"
                   DisplayMode="CompactInline"
                   IsPaneOpen="{Binding IsPaneOpen}"
                   OpenPaneLength="260"
                   CompactPaneLength="64"
                   PaneBackground="{DynamicResource SidebarBackground}"
                   IsVisible="{Binding !IsFullscreen}">
            
            <SplitView.Pane>
                <Border Name="SidebarPane" Padding="10,20" Background="Transparent" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto, *, Auto" VerticalAlignment="Stretch">
                        <!-- Hamburger -->
                        <Button Grid.Row="0" Classes="SidebarBtn" Margin="0,0,0,15" 
                                Command="{Binding TogglePaneCommand}"
                                HorizontalAlignment="Left">
                             <Viewbox Width="20" Height="20">
                                 <Canvas Width="24" Height="24">
                                     <Path Data="M4 6l16 0 M4 12l16 0 M4 18l16 0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                 </Canvas>
                             </Viewbox>
                        </Button>

                        <!-- Main Navigation -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Spacing="4">
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsLibraryActive}" Click="OnLibraryClick" ToolTip.Tip="{DynamicResource String.Library}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0 M3 6l0 13 M12 6l0 13 M21 6l0 13" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.Library}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsUpdatesActive}" Click="OnUpdatesClick" ToolTip.Tip="{DynamicResource String.Updates}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4 M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.Updates}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsUpcomingActive}" Click="OnUpcomingClick" ToolTip.Tip="{DynamicResource String.Upcoming}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12 M16 3l0 4 M8 3l0 4 M4 11l16 0 M8 15h2v2h-2l0 -2" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.Upcoming}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsHistoryActive}" Click="OnHistoryClick" ToolTip.Tip="{DynamicResource String.History}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 8l0 4l2 2 M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.History}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsDownloadsActive}" Click="OnDownloadsClick" ToolTip.Tip="{DynamicResource String.Downloads}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2 M7 11l5 5l5 -5 M12 4l0 12" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.Downloads}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                
                                <Separator Background="{DynamicResource SeparatorBrush}" Height="1" Margin="10,15" Opacity="0.5"/>
                                
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsBrowseActive}" Click="OnBrowseClick" ToolTip.Tip="{DynamicResource String.BrowseSources}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M3.6 9h16.8 M3.6 15h16.8 M11.5 3a17 17 0 0 0 0 18 M12.5 3a17 17 0 0 1 0 18" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.BrowseSources}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
     
                                <Button Classes="SidebarBtn" Classes.active="{Binding IsExtensionsActive}" Click="OnExtensionsClick" ToolTip.Tip="{DynamicResource String.Extensions}">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M21 16.008v-8.018a1.98 1.98 0 0 0 -1 -1.717l-7 -4.008a2.016 2.016 0 0 0 -2 0l-7 4.008c-.619 .355 -1 1.01 -1 1.718v8.018c0 .709 .381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7 -4.008c.619 -.355 1 -1.01 1 -1.718 M12 22v-10 M12 12l8.73 -5.04 M3.27 6.96l8.73 5.04" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{DynamicResource String.Extensions}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- Bottom Actions (Announcements, Feedback & Settings) -->
                        <StackPanel Grid.Row="2" Spacing="4" VerticalAlignment="Bottom" Margin="0,0,0,5">
                            <Button Classes="SidebarBtn" Click="OnAnnouncementClick" ToolTip.Tip="{DynamicResource String.Announcements}">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Panel Width="20" Height="20" VerticalAlignment="Center">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6 M9 17v1a3 3 0 0 0 6 0v-1" 
                                                      Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" 
                                                      StrokeLineCap="Round" StrokeJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <Border IsVisible="{Binding HasNewAnnouncement}"
                                                Background="#EF4444" CornerRadius="4"
                                                Width="8" Height="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-2,-2,0"/>
                                    </Panel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource String.Announcements}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                        <Border IsVisible="{Binding HasNewAnnouncement}"
                                                Background="#EF4444" CornerRadius="4" Padding="5,1"
                                                VerticalAlignment="Center" Classes="NavLabel">
                                            <TextBlock Text="New" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Classes="SidebarBtn" Click="OnFeedbackClick" ToolTip.Tip="{DynamicResource String.SendFeedback}">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12 M12 8v3 M12 14v.01" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource String.SendFeedback}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
 
                            <Separator Background="{DynamicResource SeparatorBrush}" Height="1" Margin="10,5" Opacity="0.5"/>
 
                            <Button Classes="SidebarBtn" Classes.active="{Binding IsSettingsActive}" Click="OnSettingsClick" ToolTip.Tip="{DynamicResource String.Settings}">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065 M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{DynamicResource String.Settings}" Classes="NavLabel" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <SplitView.Content>
                <Grid>
                    <Border ClipToBounds="True" Background="{DynamicResource PrimaryBackground}">
                        <TransitioningContentControl Content="{Binding CurrentPage}" Padding="0">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.25" />
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl>
                    </Border>
                    
                     <!-- Notification Overlay -->
                     <components:NotificationOverlay DataContext="{Binding NotificationVM}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,20,20,0"/>

                     <!-- Announcement Flyout Panel (Sidebar Attached Pop Up) -->
                     <Grid IsVisible="{Binding IsAnnouncementPanelOpen}" ZIndex="500">
                         <!-- Light Dismiss Click-away backdrop -->
                         <Border Background="#01000000" PointerPressed="OnCloseAnnouncementPanelClick"/>

                         <!-- Flyout Dialog Card -->
                         <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="16, 20, 20, 20"
                                 Width="640" Height="460"
                                 Background="{DynamicResource PrimaryBackground}"
                                 BorderBrush="{DynamicResource SeparatorBrush}"
                                 BorderThickness="1"
                                 CornerRadius="12"
                                 BoxShadow="0 10 32 0 #50000000"
                                 ClipToBounds="True">
                             <Grid RowDefinitions="Auto, *">
                                 <!-- Top Bar / Header -->
                                 <Grid Grid.Row="0" Height="48" Background="{DynamicResource SidebarBackground}" ColumnDefinitions="Auto, *, Auto">
                                     <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                                         <Border Background="#1A0078D4" CornerRadius="8" Width="30" Height="30" VerticalAlignment="Center">
                                             <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                 <Canvas Width="24" Height="24">
                                                     <Path Data="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6 M9 17v1a3 3 0 0 0 6 0v-1" 
                                                           Stroke="#0078D4" StrokeThickness="2" Fill="Transparent" 
                                                           StrokeLineCap="Round" StrokeJoin="Round"/>
                                                 </Canvas>
                                             </Viewbox>
                                         </Border>
                                         <TextBlock Text="{DynamicResource String.Announcements}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                                     </StackPanel>

                                     <!-- Close Button -->
                                     <Button Grid.Column="2" Click="OnCloseAnnouncementPanelClick"
                                             Background="Transparent" Padding="8" Margin="0,0,12,0" CornerRadius="6" Cursor="Hand"
                                             VerticalAlignment="Center">
                                         <Viewbox Width="14" Height="14">
                                             <Canvas Width="24" Height="24">
                                                 <Path Data="M18 6l-12 12 M6 6l12 12" Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                             </Canvas>
                                         </Viewbox>
                                     </Button>
                                 </Grid>

                                 <!-- Body: 2 Columns (Left: Pill List, Right: Content Details) -->
                                 <Grid Grid.Row="1" ColumnDefinitions="220, *">
                                     
                                     <!-- Left Column: List of Announcement Pills -->
                                     <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,1,0" Padding="12,12,8,12">
                                         <ScrollViewer VerticalScrollBarVisibility="Auto">
                                             <ItemsControl ItemsSource="{Binding Announcements}">
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Button Classes="AnnouncementPill"
                                                                 Classes.selected="{Binding IsSelected}"
                                                                 Click="OnAnnouncementItemClick"
                                                                 Margin="0,0,0,8"
                                                                 HorizontalAlignment="Stretch">
                                                             <TextBlock Text="{Binding Title}" 
                                                                        TextWrapping="Wrap" 
                                                                        MaxLines="2" 
                                                                        FontSize="12" 
                                                                        FontWeight="SemiBold" 
                                                                        VerticalAlignment="Center"/>
                                                         </Button>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </ScrollViewer>
                                     </Border>

                                     <!-- Right Column: Detail Content -->
                                     <Border Grid.Column="1" Background="{DynamicResource PrimaryBackground}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                                         <Grid>
                                             <!-- Loading State -->
                                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding IsAnnouncementLoading}">
                                                 <ProgressBar IsIndeterminate="True" Width="140" Height="4"/>
                                                 <TextBlock Text="Memeriksa pengumuman..." FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                             </StackPanel>

                                             <!-- Empty State -->
                                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" 
                                                         IsVisible="{Binding !Announcements.Count}">
                                                 <Viewbox Width="32" Height="32" Opacity="0.5">
                                                     <Canvas Width="24" Height="24">
                                                         <Path Data="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6 M9 17v1a3 3 0 0 0 6 0v-1" 
                                                               Stroke="{DynamicResource SecondaryText}" StrokeThickness="2" Fill="Transparent" 
                                                               StrokeLineCap="Round" StrokeJoin="Round"/>
                                                     </Canvas>
                                                 </Viewbox>
                                                 <TextBlock Text="Belum ada pengumuman saat ini." FontSize="12" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                                             </StackPanel>

                                             <!-- Announcement Details -->
                                             <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !!Announcements.Count}">
                                                 <StackPanel Spacing="12" DataContext="{Binding SelectedAnnouncement}">
                                                     <!-- Meta row: Type pill and Date -->
                                                     <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                         <Border Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2">
                                                             <TextBlock Text="{Binding Type}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                         </Border>
                                                         <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                                                     </StackPanel>

                                                     <!-- Title -->
                                                     <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"/>

                                                     <!-- Separator line -->
                                                     <Rectangle Fill="{DynamicResource SeparatorBrush}" Height="1" Margin="0,2,0,4"/>

                                                     <!-- Body Text -->
                                                     <TextBlock Text="{Binding Body}" FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" LineHeight="20"/>

                                                     <!-- Link button if URL exists -->
                                                     <Button Classes="ActionLinkBtn"
                                                             Tag="{Binding Url}"
                                                             Click="OnOpenAnnouncementUrlClick"
                                                             IsVisible="{Binding HasUrl}"
                                                             HorizontalAlignment="Left"
                                                             Margin="0,8,0,0">
                                                         <StackPanel Orientation="Horizontal" Spacing="6">
                                                             <TextBlock Text="Kunjungi Tautan" FontSize="12" FontWeight="SemiBold"/>
                                                             <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                                                 <Canvas Width="24" Height="24">
                                                                     <Path Data="M11 7h-5a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-5 M10 14l10 -10 M15 4l5 0l0 5" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Fill="Transparent" StrokeLineCap="Round" StrokeJoin="Round"/>
                                                                 </Canvas>
                                                             </Viewbox>
                                                         </StackPanel>
                                                     </Button>
                                                 </StackPanel>
                                             </ScrollViewer>
                                         </Grid>
                                     </Border>
                                 </Grid>
                             </Grid>
                         </Border>
                     </Grid>
                </Grid>
            </SplitView.Content>
        </SplitView>
        
        <!-- Fullscreen Content: No Sidebar, No Title Bar -->
        <Grid IsVisible="{Binding IsFullscreen}" Background="Black">
            <Border ClipToBounds="True" Background="Black">
                <TransitioningContentControl Content="{Binding CurrentPage}" Padding="0">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.25" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Border>
        </Grid>
        
        <!-- Global Dialog Overlay (Dimming Effect) -->
        <Border Background="#90000000" 
                IsVisible="{Binding IsDialogOverlayVisible}"
                ZIndex="1000">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Full Screen Image Overlay for Theme Transition Crossfade -->
        <Image RenderOptions.BitmapInterpolationMode="HighQuality" x:Name="ThemeTransitionOverlay" ZIndex="2000" IsHitTestVisible="False" IsVisible="False" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
            </Image.RenderTransform>
        </Image>
    </Panel>
</Window>

