<Window x:Class="YomicDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Yomic"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1280"
        Height="800"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="MainWindowChrome"
                            CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="CaptionBtnHoverBg" Color="#E5E5E5" />
        <SolidColorBrush x:Key="CaptionBtnPressedBg" Color="#CACACA" />
        <SolidColorBrush x:Key="CaptionBtnHoverFg" Color="#000000" />

        <!-- Windows Standard Caption Button Style -->
        <Style x:Key="TitleBarCaptionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource CaptionBtnHoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource CaptionBtnHoverFg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource CaptionBtnPressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Standard Close Button Style (Red Hover) -->
        <Style x:Key="TitleBarCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource TitleBarCaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid" Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- ROW 0: WINDOWS STANDARD TITLE BAR (Matching Chrome/Drive PWA)     -->
        <!-- ================================================================= -->
        <Border x:Name="TitleBarBorder"
                Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Standard App Icon & Window Title Text -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="9,0,12,0"
                            IsHitTestVisible="False">
                    <Image Source="pack://application:,,,/Assets/app.ico"
                           Width="16"
                           Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleBarAppNameText"
                               Text="Yomic"
                               Foreground="#1F1F1F"
                               FontSize="12"
                               FontWeight="Normal"
                               FontFamily="Segoe UI, Segoe UI Variable Text, Arial"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Standard Windows Caption Controls (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Minimize Button -->
                    <Button x:Name="MinimizeCaptionBtn"
                            Style="{StaticResource TitleBarCaptionBtnStyle}"
                            ToolTip="Minimize"
                            Click="OnMinimizeButtonClick">
                        <Path Data="M 0,5 L 10,5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Width="10"
                              Height="10" />
                    </Button>

                    <!-- Maximize / Restore Button -->
                    <Button x:Name="MaxRestoreCaptionBtn"
                            Style="{StaticResource TitleBarCaptionBtnStyle}"
                            ToolTip="Maximize / Restore"
                            Click="OnMaximizeRestoreButtonClick">
                        <Path x:Name="MaxRestoreIconPath"
                              Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Width="10"
                              Height="10" />
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="CloseCaptionBtn"
                            Style="{StaticResource TitleBarCloseBtnStyle}"
                            ToolTip="Close"
                            Click="OnCloseButtonClick">
                        <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"
                              Width="10"
                              Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 1: WEBVIEW2 MODERN TYPESCRIPT UI LAYER                        -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="YomicWebView"
                          DefaultBackgroundColor="#FFFFFF"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
